        <path class="ol-w" pathLength="1" style="--d:2.45s" d="M857 85 H884 V133 H857 Z" />
        <path class="ol-w" pathLength="1" style="--d:2.5s" d="M857 235 H884 V301 H857 Z" />
        <path class="ol-w" pathLength="1" style="--d:2.55s" d="M749 212 H775 V287 H749 Z" />
        <path class="ol-w" pathLength="1" style="--d:2.6s" d="M988 160 H1039 V287 H988 Z" />
        <path class="ol-w" pathLength="1" style="--d:2.7s" d="M988 310 H1040 V440 H988 Z" />
        <path class="ol-w" pathLength="1" style="--d:2.65s" d="M1255 192 H1275 V305 H1255 Z" />
        </svg>
      </div>
    </div>

    <div class="hero-dots"></div>
  </div>


  <!-- TEXT SCRIM -->
  <div class="hero-text-scrim"></div>


  <!-- =====================================================
       HERO CONTENT
       ===================================================== -->

  <div class="hero-scenes" id="heroScenes">

    <div class="hero-scenes-sticky">


      <div class="hero-content">

        <div class="hero-main">


          <!-- EYEBROW -->
          <div class="hero-eyebrow">
            Full-service
            <span
              class="term"
              tabindex="0"
              data-tip="AEC = Architecture, Engineering &amp; Construction. In simple words: the building industry."
            > AEC </span>
            production partner
          </div>


          <!-- MAIN HEADING -->
          <h1>

            <span class="line line-1">
              AEC production
            </span>

            <span class="line line-2">
              without the <br> <span class="accent">production friction.</span>
            </span>

          </h1>


          <p class="hero-lead">
            We turn architects' drawings into 3D models, renders and walkthroughs,
            so you can see the building before it's built.
          </p>


          <!-- HERO BUTTONS -->
          <div class="hero-buttons">

            <a
              href="/services"
              class="primary-button"
            >
              <span>
                Review the full pipeline
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>


            <a
              href="/contact"
              class="secondary-button"
            >
              <span>
                Discuss a production package
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>

          </div>


          <!-- <div class="hero-fit" role="group" aria-label="Find the right fit for you">
            <span class="hero-fit-label">Find your fit</span>

            <a href="#buyer-segments" class="fit-chip" data-segment="architect">I design buildings</a>
            <a href="#buyer-segments" class="fit-chip" data-segment="engineer">I coordinate engineering</a>
            <a href="#buyer-segments" class="fit-chip" data-segment="developer">I develop property</a>
          </div> -->

        </div>

      </div>


      <!-- <div class="hero-scroll-cue">

        <span>
          Scroll
        </span>

        <span class="scroll-line"></span>

      </div> -->


    </div>

  </div>

</section>


<style is:global>
  /* Text: left side, vertically beech mein */
  .hero .hero-content {
    justify-content: center;
    padding: 130px 6% 70px;
  }
  .hero .hero-main {
    max-width: 720px;
  }
  .hero .hero-main h1 {
    font-size: clamp(36px, 4.2vw, 60px);
    max-width: 720px;
    line-height: 1.1 !important;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }
  /* 2nd line: solid purple (pehle brown tha) */
  .hero h1 .accent {
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    -webkit-text-fill-color: #9318d7;
    color: #9318d7 !important;
  }
  .hero .hero-eyebrow {
    font-size: 12.5px;
    margin-bottom: 18px;
  }
  .hero .hero-lead {
    font-size: 13px;
    max-width: 480px;
    margin-top: 16px;
  }
  .hero .hero-buttons {
    margin-top: 26px;
  }
  .hero .primary-button,
  .hero .secondary-button {
    min-height: 34px;
    padding: 0 14px;
    font-size: 11.5px;
  }
  @media (max-width: 1100px) {
    .hero .hero-content { padding: 110px 5% 60px; }
    .hero .hero-main h1 { font-size: clamp(34px, 5.8vw, 54px); }
  }
  @media (max-width: 768px) {
    .hero .hero-content { justify-content: flex-end; padding: 100px 6% 50px; }
    .hero .hero-main { max-width: 100%; }
    .hero .hero-main h1 { font-size: clamp(30px, 8.4vw, 44px); }
    .hero .hero-eyebrow { font-size: 11px; }
    .hero .hero-lead { font-size: 12px; }
    .hero .primary-button,
    .hero .secondary-button { min-height: 36px; font-size: 11px; }
  }
</style>