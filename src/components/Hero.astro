---
import "../styles/Hero.css";
---

<!-- =====================================================
     UX BRIEF — HERO
     Visitor ka sawal : "Ye log kya karte hain, aur kya ye mere liye hai?"
     Jawab (5 second): drawings -> 3D models / renders / walkthroughs.

     BACKGROUND: pehle outline draw, phir black & grey building photo reveal.
     Numbering / progress lines nahi hain. Photo badalni ho to <img class="hero-photo"> ka src badlo.
     ===================================================== -->

<section class="hero hero--photo text-in" id="axysHero">

  <!-- ================= FONTS ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    rel="stylesheet"
  />


  <!-- ================= BACKGROUND =================
       1) Pehle building ka outline "draw" hota hai (SVG lines)
       2) Phir photo neeche se upar reveal hoti hai
       3) Aakhir me outline fade ho jata hai
       Photo: /public/hero/building.jpg  (outline isi photo ke hisaab se trace hui hai,
       isliye photo badlo to outline ka SVG bhi badalna hoga ya <svg> hata do). -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-frame hero-frame--photo">
      <div class="hero-frame-inner">
        <img
          class="hero-photo"
          src="/public/images/building.jpg"
          alt=""
          width="1344"
          height="768"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-frame hero-frame--lines">
      <div class="hero-frame-inner">
        <svg class="hero-outline" viewBox="0 0 1344 768" preserveAspectRatio="none" focusable="false">
        <path class="ol-fill" d="M902 187 L959 137 L1199 75 L1292 199 V467 H932 V320 L902 320 Z" />
        <path pathLength="1" style="--d:0.35s" d="M109 237 L150 213 L353 115 L517 201" />
        <path pathLength="1" style="--d:0.7s" d="M353 115 V297" />
        <path pathLength="1" style="--d:0.5s" d="M109 237 V367" />
        <path pathLength="1" style="--d:0.6s" d="M109 367 L360 295" />
        <path pathLength="1" style="--d:0.8s" d="M517 201 V468" />
        <path pathLength="1" style="--d:0.9s" d="M125 367 V624" />
        <path pathLength="1" style="--d:1.0s" d="M127 487 L381 455" />
        <path pathLength="1" style="--d:1.1s" d="M423 455 L672 490" />
        <path pathLength="1" style="--d:1.2s" d="M381 463 V628 M423 463 V628" />
        <path pathLength="1" style="--d:0.15s" d="M110 624 H1330" />
        <path pathLength="1" style="--d:0.9s" d="M465 168 L565 133 L672 192 L775 163" />
        <path pathLength="1" style="--d:1.2s" d="M465 168 V210" />
        <path pathLength="1" style="--d:1.0s" d="M775 85 L892 52 L962 137" />
        <path pathLength="1" style="--d:1.15s" d="M775 85 V352 H940" />
        <path pathLength="1" style="--d:1.3s" d="M899 52 V347" />
        <path pathLength="1" style="--d:1.2s" d="M934 67 L1079 21 L1105 99" />
        <path pathLength="1" style="--d:1.4s" d="M934 67 V135 M1079 21 V95" />
        <path class="ol-a" pathLength="1" style="--d:1.3s" d="M902 187 L959 137 L1199 75 L1292 199 V467 H932 V320 L902 320 Z" />
        <path class="ol-a" pathLength="1" style="--d:1.9s" d="M1199 75 V467" />
        <path pathLength="1" style="--d:2.0s" d="M1292 199 L1313 277 V470 L1292 467" />
        <path pathLength="1" style="--d:2.1s" d="M932 477 L960 492 H1135" />
        <path pathLength="1" style="--d:1.5s" d="M819 403 H929 V623 M819 403 V623" />
        <path pathLength="1" style="--d:1.7s" d="M672 603 L739 507 M752 587 L815 493" />
        <path class="ol-w" pathLength="1" style="--d:1.9s" d="M690 598 H752 M705 580 H765 M720 562 H780 M735 544 H795 M745 526 H805" />
        <path pathLength="1" style="--d:1.6s" d="M727 148 V475" />
        <path class="ol-w" pathLength="1" style="--d:2.0s" d="M480 517 H623 V617 H480 Z M527 517 V617" />
        <path class="ol-w" pathLength="1" style="--d:2.1s" d="M939 503 H1082 V617 H939 Z M1002 503 V617" />
        <path pathLength="1" style="--d:1.8s" d="M1135 457 V622 M1192 457 V622" />
