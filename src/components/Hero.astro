    font-size: clamp(36px, 3.9vw, 62px);
    max-width: 780px;
    line-height: 1.02 !important;
  }
  /* 3rd line: solid brown (gradient hata diya) */
  .hero h1 .accent {
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    -webkit-text-fill-color: #8f6444;
    color: #8f6444 !important;
  }
  .hero .hero-eyebrow {
    font-size: 13px;
    margin-bottom: 20px;
  }
  .hero .hero-lead {
    font-size: 19px;
    max-width: 580px;
