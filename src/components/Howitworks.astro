---
import "../styles/Howitworks.css";

// Tabs (5 phases). Replay steps through all 14 events below, like the recording.
const tabs = [
  { num: "01", label: "Brief" },
  { num: "02", label: "Expert analysis" },
  { num: "03", label: "Sketch & 2D plan" },
  { num: "04", label: "3D BIM model" },
  { num: "05", label: "Renders & film" },
];

// slide: 0 = client brief card, 1 = stage1, 2 = stage2, 3 = before, 4 = after
// badge: [text, tone] or null.  tone: ok | rev
const events = [
  { tab: 0, slide: 0, role: "CLIENT", cls: "role-client", logCls: "log-client", logRole: "Client", day: "DAY 1", title: "Brief received", desc: "Requirements, references and deadline submitted.", qc: 0, badge: null },
  { tab: 1, slide: 0, role: "AXYS3D LEAD", cls: "role-lead", logCls: "log-lead", logRole: "Axys3D lead", day: "DAY 1", title: "Expert analysis", desc: "Scope, codes and deliverables confirmed.", qc: 0, badge: null },
  { tab: 2, slide: 1, role: "DESIGNER", cls: "role-designer", logCls: "log-designer", logRole: "Designer", day: "DAY 2", title: "Sketch & 2D plan", desc: "Concept linework and floor plans drafted.", qc: 0, badge: null },
  { tab: 2, slide: 1, role: "QC TEAM", cls: "role-qc", logCls: "log-qc", logRole: "QC team", day: "DAY 2", title: "Quality check passed", desc: "Dimensions, layout and brief compliance verified.", qc: 1, badge: ["✓ QC passed", "ok"] },
  { tab: 2, slide: 1, role: "CLIENT", cls: "role-client", logCls: "log-client", logRole: "Client", day: "DAY 3", title: "Plan approved", desc: "Go ahead for the BIM model.", qc: 1, badge: ["✓ Client approved", "ok"] },
  { tab: 3, slide: 2, role: "BIM MODELER", cls: "role-modeler", logCls: "log-bim", logRole: "BIM modeler", day: "DAY 4", title: "3D BIM model built", desc: "Structure, facade and floors modelled in Revit.", qc: 1, badge: null },
  { tab: 3, slide: 2, role: "QC TEAM", cls: "role-qc", logCls: "log-qc", logRole: "QC team", day: "DAY 5", title: "Quality check passed", desc: "Clash detection and standards verified.", qc: 2, badge: ["✓ QC passed", "ok"] },
  { tab: 3, slide: 2, role: "CLIENT", cls: "role-client", logCls: "log-client", logRole: "Client", day: "DAY 5", title: "Revision requested", desc: "Widen the lower deck stair.", qc: 2, badge: ["↻ Revision", "rev"] },
  { tab: 3, slide: 3, role: "BIM MODELER", cls: "role-modeler", logCls: "log-bim", logRole: "BIM modeler", day: "DAY 6", title: "Revision complete", desc: "Changes made and sent back to QC.", qc: 2, badge: null },
  { tab: 3, slide: 3, role: "QC TEAM", cls: "role-qc", logCls: "log-qc", logRole: "QC team", day: "DAY 6", title: "Re-check passed", desc: "Model cleared for the client.", qc: 3, badge: ["✓ QC passed", "ok"] },
  { tab: 3, slide: 3, role: "CLIENT", cls: "role-client", logCls: "log-client", logRole: "Client", day: "DAY 6", title: "BIM approved", desc: "Files released to visualization.", qc: 3, badge: ["✓ Client approved", "ok"] },
  { tab: 4, slide: 4, role: "RENDERER", cls: "role-render", logCls: "log-render", logRole: "Renderer", day: "DAY 8", title: "Renders & film produced", desc: "Materials, lighting and environment designed.", qc: 3, badge: ["✓ Client approved", "ok"] },
  { tab: 4, slide: 4, role: "QC TEAM", cls: "role-qc", logCls: "log-qc", logRole: "QC team", day: "DAY 9", title: "Final visual QC passed", desc: "Colour, detail and framing checked.", qc: 4, badge: ["✓ QC passed", "ok"] },
  { tab: 4, slide: 4, role: "CLIENT", cls: "role-client", logCls: "log-client", logRole: "Client", day: "DAY 9", title: "Delivered", desc: "Final package approved.", qc: 4, badge: ["✓ Delivered", "ok"] },
];

// 4 images, in this order: stage1 -> stage2 -> before -> after
// Har image ko barabar time: 3 events x 1400ms = 4.2s each (events 2-4, 5-7, 8-10, 11-13).
// Put them in /public/images/ . Any of jpg/png/jpeg/webp/avif works.
const imgs = [
  { stems: "/images/stage1", name: "stage1", alt: "Sketch and 2D plan" },
  { stems: "/images/stage2", name: "stage2", alt: "3D BIM model" },
  { stems: "/images/before", name: "before", alt: "3D BIM model, revised" },
  { stems: "/images/after", name: "after", alt: "Final delivered render" },
];
const first = events[0];

// =====================================================
// CASE STUDY CONTENT (yahan se text badal sakte ho)
// Numbers neeche `events` se khud calculate hote hain, isliye replay badlo to ye bhi sync rahenge.
// =====================================================
const dayNum = (e: { day: string }) => Number(String(e.day).replace(/\D/g, ""));
const totalDays = dayNum(events[events.length - 1]);
const qcChecks = Math.max(...events.map((e) => e.qc));
const revIdx = events.findIndex((e) => e.badge && e.badge[1] === "rev");
const revisions = events.filter((e) => e.badge && e.badge[1] === "rev").length;
const revText = revIdx >= 0 ? `Requested Day ${dayNum(events[revIdx])}, closed Day ${dayNum(events[revIdx + 1])}` : "";

const caseStudy = {
  project: "Hillside residence",
  // Button yahan le jayega. Apne case study page ka link yahan likho (jaise "/work/hillside-residence")
  href: "/work",
  buttonText: "View full case study",
  facts: [
    { label: "Project", value: "Hillside residence" },
    { label: "Scope", value: "BIM model, renders" },
    { label: "Inputs", value: "Survey, sketches" },
    { label: "Timeline", value: `${totalDays} days, brief to delivery` },
  ],
  outcomes: [
    { value: totalDays, suffix: " days", label: "From brief to final delivery" },
    { value: qcChecks, suffix: " QC checks", label: "Passed in-house before the client saw each stage" },
    { value: revisions, suffix: revisions === 1 ? " revision" : " revisions", label: revText },
  ],
};
---

<section class="hw-section" id="howItWorks">
  <div class="hw-container">
    <div class="hw-header">
      <span class="hw-tag">CASE STUDY · {caseStudy.project.toUpperCase()}</span>
      <h2 class="hw-title">Brief to delivery<br />in <span class="hw-highlight">{totalDays} days.</span></h2>
      <p class="hw-subtitle">Follow one project step by step. Every stage passed in-house QC before the client saw it.</p>
    </div>

    <div class="hw-player" id="hwPlayer">
      <div class="hw-stage-wrapper">
        <div class="hw-screen">
          <div class="hw-slide is-active" data-slide="0">
            <div class="hw-brief-card">
              <div class="hw-brief-header">CLIENT BRIEF</div>
              <div class="hw-brief-rows">
                <div class="hw-brief-row"><span class="hw-brief-label">Project</span><span class="hw-brief-val">Hillside residence</span></div>
                <div class="hw-brief-row"><span class="hw-brief-label">Scope</span><span class="hw-brief-val">BIM model, renders</span></div>
                <div class="hw-brief-row"><span class="hw-brief-label">Inputs</span><span class="hw-brief-val">Survey, sketches</span></div>
              </div>
            </div>
          </div>

          {imgs.map((im, i) => (
            <div class="hw-slide" data-slide={i + 1} data-missing={`${im.name} not found. Add it to /public/images/`}>
              <img class="hw-slide-img" data-stem={im.stems} alt={im.alt} decoding="async" />
            </div>
          ))}

          <div class="hw-screen-badge" id="hwScreenBadge" hidden><span id="hwBadgeText"></span></div>
        </div>

        <div class="hw-info-pane">
          <!-- CASE STUDY INFO: line by line (player ke andar) -->
          <div class="hw-case-info">
            {caseStudy.facts.map((f) => (
              <div class="hw-case-row">
                <span class="hw-case-label">{f.label}</span>
                <span class="hw-case-val">{f.value}</span>
              </div>
            ))}
          </div>

          <div class="hw-info-header">
            <div class="hw-role role-client" id="hwRoleBadge"><span class="hw-role-dot"></span><span id="hwRoleText">{first.role}</span></div>
            <div class="hw-day" id="hwDayText">{first.day}</div>
          </div>
          <h3 class="hw-step-title" id="hwStepTitle">{first.title}</h3>
          <p class="hw-step-desc" id="hwStepDesc">{first.desc}</p>

          <div class="hw-qc-status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <span><b id="hwQcNum">0</b> in house QC checks passed</span>
          </div>

          <div class="hw-controls">
            <button type="button" class="hw-btn hw-btn-secondary" id="hwPlayBtn"><span id="hwPlayIcon"></span><span id="hwPlayLabel">Pause</span></button>
            <button type="button" class="hw-btn hw-btn-secondary" id="hwToggleLogBtn">Show project log</button>
            <button type="button" class="hw-btn hw-btn-play hw-btn-skip" id="hwSkipBtn"><span>Skip</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="hw-project-log" id="hwProjectLog" aria-hidden="true">
        <div class="hw-log-inner">
          <div class="hw-log-scroll" id="hwLogScroll">
            {[...events].map((e, i) => ({ e, i })).reverse().map(({ e, i }) => (
              <div class="hw-log-row" data-ev={i}>
                <span class="hw-log-day">{e.day}</span>
                <span class={`hw-log-role ${e.logCls}`}>{e.logRole}</span>
                <span class="hw-log-msg">{e.title}. {e.desc}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="hw-timeline">
        <div class="hw-progress"><i id="hwProgress"></i></div>
        {tabs.map((t, i) => (
          <button type="button" class={`hw-tab ${i === 0 ? "is-active" : ""}`} data-tab={i} aria-label={`Step ${t.num}: ${t.label}`}>
            {i === 3 && <span class="hw-revision-pill" id="hwRevPill" hidden><span class="hw-rev-dot">●</span> 1 REVISION</span>}
            <span class="hw-tab-num">{t.num}</span>
            <span class="hw-tab-label">{t.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- CASE STUDY RESULT: project ka nateeja -->
    <div class="hw-outcome-wrap">
      <span class="hw-outcome-tag">RESULT</span>
      <div class="hw-outcome">
        {caseStudy.outcomes.map((o) => (
          <div class="hw-outcome-card">
            <div class="hw-outcome-num"><span class="hw-outcome-value">{o.value}</span><span class="hw-outcome-suffix">{o.suffix}</span></div>
            <p class="hw-outcome-label">{o.label}</p>
          </div>
        ))}
      </div>

      <a href={caseStudy.href} class="hw-case-link">
        <span>{caseStudy.buttonText}</span>
        <span class="hw-case-link-arrow">↗</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ events, tabCount: tabs.length }}>
  (function () {
    const root = document.getElementById("hwPlayer");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const $ = (id) => document.getElementById(id);
    const slides = [...root.querySelectorAll(".hw-slide")];
    const tabEls = [...root.querySelectorAll(".hw-tab")];
    const logRows = [...root.querySelectorAll(".hw-log-row")];
    const bar = $("hwProgress"), badge = $("hwScreenBadge"), revPill = $("hwRevPill");
    const N = events.length, DUR = 1400;
    const ICON = {
      pause: '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>',
      play: '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21"/></svg>',
      replay: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="1 4 1 10 7 10"/><path d="M3.5 15a9 9 0 1 0 2.1-9.4L1 10"/></svg>',
    };

    // ---- images: try each candidate once, then stop (no infinite loop) ----
    root.querySelectorAll("img[data-stem]").forEach((img) => {
      const list = [];
      img.dataset.stem.split("|").forEach((s) => ["jpg", "png", "jpeg", "webp", "avif"].forEach((x) => list.push(`${s}.${x}`)));
      let n = 0;
      img.onerror = () => {
        n++;
        if (n < list.length) img.src = list[n];
        else { img.onerror = null; img.removeAttribute("src"); img.closest(".hw-slide").classList.add("is-missing"); }
      };
      img.src = list[0];
    });

    let cur = 0, playing = false, finished = false, timer = 0, evStart = 0, remain = DUR, started = false;

    function paint(i) {
      cur = i;
      const e = events[i];
      slides.forEach((s, k) => s.classList.toggle("is-active", k === e.slide));
      tabEls.forEach((t, k) => { t.classList.toggle("is-active", k === e.tab); t.classList.toggle("is-passed", k < e.tab); });
      $("hwRoleBadge").className = `hw-role ${e.cls}`;
      $("hwRoleText").textContent = e.role;
      $("hwDayText").textContent = e.day;
      $("hwStepTitle").textContent = e.title;
      $("hwStepDesc").textContent = e.desc;
      $("hwQcNum").textContent = e.qc;
      ["hwStepTitle", "hwStepDesc"].forEach((id) => { const el = $(id); el.classList.remove("hw-in"); void el.offsetWidth; el.classList.add("hw-in"); });
      if (e.badge) { badge.hidden = false; badge.className = `hw-screen-badge tone-${e.badge[1]}`; $("hwBadgeText").textContent = e.badge[0]; }
      else badge.hidden = true;
      revPill.hidden = i < 7;
      logRows.forEach((r) => r.classList.toggle("is-highlighted", Number(r.dataset.ev) === i));
      const active = root.querySelector(".hw-log-row.is-highlighted");
      const sc = $("hwLogScroll");
      if (active && $("hwProjectLog").classList.contains("is-open")) sc.scrollTo({ top: active.offsetTop - sc.offsetTop - 40, behavior: "smooth" });
    }

    function setBar(from, to, ms) {
      bar.style.transition = "none";
      bar.style.transform = `scaleX(${from})`;
      void bar.offsetWidth;
      bar.style.transition = ms ? `transform ${ms}ms linear` : "none";
      bar.style.transform = `scaleX(${to})`;
    }

    function setBtn(state) {
      $("hwPlayIcon").innerHTML = ICON[state];
      $("hwPlayLabel").textContent = { pause: "Pause", play: "Play", replay: "Replay" }[state];
    }

    function run(ms) {
      clearTimeout(timer);
      evStart = performance.now();
      remain = ms;
      timer = setTimeout(() => {
        if (cur < N - 1) { go(cur + 1); }
        else finish();
      }, ms);
    }

    function go(i) {
      paint(i);
      if (playing) { setBar(i / N, (i + 1) / N, DUR); run(DUR); }
      else setBar((i + 1) / N, (i + 1) / N, 0);
    }

    function finish() {
      playing = false; finished = true;
      clearTimeout(timer);
      setBar(1, 1, 0);
      setBtn("replay");
    }

    function play() {
      playing = true; finished = false; setBtn("pause");
      const from = cur / N, to = (cur + 1) / N;
      if (remain >= DUR) { setBar(from, to, DUR); run(DUR); }
      else { setBar(parseFloat(getComputedStyle(bar).transform.split(",")[0].replace("matrix(", "")) || from, to, remain); run(remain); }
    }

    function pause() {
      playing = false; clearTimeout(timer);
      remain = Math.max(60, DUR - (performance.now() - evStart));
      const m = getComputedStyle(bar).transform;
      const sx = m && m !== "none" ? parseFloat(m.split(",")[0].replace("matrix(", "")) : cur / N;
      bar.style.transition = "none"; bar.style.transform = `scaleX(${sx})`;
      setBtn("play");
    }

    const firstOfTab = (t) => events.findIndex((e) => e.tab === t);

    $("hwPlayBtn").addEventListener("click", () => {
      if (finished) { remain = DUR; paint(0); play(); }
      else if (playing) pause();
      else play();
    });
    $("hwSkipBtn").addEventListener("click", () => {
      const nt = (events[cur].tab + 1) % tabCount;
      remain = DUR; finished = false; go(firstOfTab(nt));
      if (!playing && !finished && started) { /* stay paused on the new step */ }
    });
    tabEls.forEach((t, k) => t.addEventListener("click", () => { remain = DUR; finished = false; go(firstOfTab(k)); }));

    $("hwToggleLogBtn").addEventListener("click", () => {
      const log = $("hwProjectLog");
      const open = log.classList.toggle("is-open");
      log.setAttribute("aria-hidden", String(!open));
      $("hwToggleLogBtn").textContent = open ? "Hide project log" : "Show project log";
    });

    // start once, when the player scrolls into view (plays once, no auto-loop)
    paint(0); setBar(0, 0, 0); setBtn("play");
    new IntersectionObserver(([en], ob) => {
      if (en.isIntersecting) { ob.disconnect(); started = true; remain = DUR; play(); }
    }, { threshold: 0.35 }).observe(root);
  })();
</script>