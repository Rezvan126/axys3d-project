---
import "../styles/Navbar.css";
import Logo from "./logo.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Industries", href: "/industries" },
  { label: "Work", href: "/work" },
  { label: "Process", href: "/process" },
  { label: "Insights", href: "/insights" },
  { label: "Visuals", href: "/visuals" },
  { label: "About", href: "/about" },
];

// Current page ko highlight karne ke liye
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.toLowerCase() === href.toLowerCase() ||
  path.toLowerCase().startsWith(href.toLowerCase() + "/");
---

<!-- =====================================================
     FIXED FLOATING NAVBAR (har page py scroll k sath tiki rehti hai)
     ===================================================== -->
<header class="site-header" id="siteHeader">

  <div class="site-header-inner">

    <!-- LOGO -->
    <a href="/" class="logo" aria-label="Axys3D Home">
      <Logo class="logo-img" />
    </a>

    <!-- CENTER PILL NAV (desktop) -->
    <nav class="floating-nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class={isActive(l.href) ? "is-active" : ""}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- RIGHT SIDE -->
    <div class="nav-right">

      <a href="/contact" class="topbar-cta">
        <span>Discuss a production package</span>
        <span class="arrow">↗</span>
      </a>

      <button
        class="menu-toggle-btn"
        id="menuToggleBtn"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="sideNav"
      >
        <span class="menu-toggle-label" id="menuToggleLabel">Menu</span>
        <span class="menu-toggle-lines">
          <i></i>
          <i></i>
          <i></i>
        </span>
      </button>

    </div>

  </div>

</header>


<!-- SIDE MENU (tablet / mobile) -->
<div class="side-nav-scrim" id="sideNavScrim"></div>

<aside class="side-nav" id="sideNav" aria-label="Mobile navigation">
  <span class="side-nav-kicker">Navigation</span>

  <ul class="side-nav-links">
    {links.map((l, i) => (
      <li>
        <a href={l.href} class={isActive(l.href) ? "is-active" : ""}>
          <span class="side-nav-link-index">{String(i + 1).padStart(2, "0")}</span>
          <span class="side-nav-link-text">{l.label}</span>
          <span class="side-nav-link-arrow">↗</span>
        </a>
      </li>
    ))}
  </ul>

  <a href="/contact" class="side-nav-cta">
    <span>Discuss a production package</span>
    <span>↗</span>
  </a>
</aside>


<script>
  const header = document.getElementById("siteHeader") as HTMLElement | null;
  const btn = document.getElementById("menuToggleBtn") as HTMLButtonElement | null;
  const label = document.getElementById("menuToggleLabel") as HTMLElement | null;
  const scrim = document.getElementById("sideNavScrim") as HTMLElement | null;
  const sideNav = document.getElementById("sideNav") as HTMLElement | null;
  // Parent par transform/overflow ho to bhi fixed chale
  [header, scrim, sideNav].forEach((el) => {
    if (el) document.body.appendChild(el);
  });
  /* ---------- Scroll par navbar ka background ---------- */
  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* ---------- Menu open / close ---------- */
  const setOpen = (open: boolean) => {
    document.body.classList.toggle("menu-open", open);
    btn?.classList.toggle("is-open", open);
    btn?.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Close" : "Menu";
  };

  btn?.addEventListener("click", () => {
    setOpen(!document.body.classList.contains("menu-open"));
  });

  scrim?.addEventListener("click", () => setOpen(false));

  sideNav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  window.matchMedia("(min-width: 1301px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  /* Logo image: text ki jagah. Height se size control hota hai. */
  .logo { display: inline-flex; align-items: center; line-height: 0; }
  .logo-img { display: block; height: 28px; width: auto; }
  @media (max-width: 640px) { .logo-img { height: 24px; } }
</style>