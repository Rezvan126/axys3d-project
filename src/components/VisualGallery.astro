---
import "../styles/Visual-Gallery.css";

// 8 services = 8 gallery frames.
const unsplash = (id: string) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1800&q=85`;

const gallery = [
  { slug: "bim-production", kind: "BIM MODEL", scope: "BIM modeling, coordination", tools: "Revit, Navisworks", deliver: "Coordinated BIM model", short: "BIM Production", service: "BIM Execution & Model Production", headline: "Coordinated building models, ready for construction", description: "See the BIM models we build, with every wall, floor and opening set up to your firm's standards.", image: unsplash("photo-1678388583153-f0e667c97288") },
  { slug: "revit-production", kind: "DOCUMENTATION", scope: "Plans, sections, details", tools: "Revit", deliver: "Construction drawing set", short: "Revit Documentation", service: "Revit Production & Documentation", headline: "Drawing sets that always match the model", description: "Plans, sections and construction drawings produced in Revit and issued on schedule.", image: unsplash("photo-1746308674931-12bacad54df7") },
  { slug: "mep-coordination", kind: "COORDINATION", scope: "MEP clash resolution", tools: "Revit, Navisworks", deliver: "Clash report, resolved model", short: "MEP Coordination", service: "MEP Coordination Support", headline: "Pipes, ducts and wiring, without clashes", description: "See mechanical, electrical and plumbing systems checked and resolved before site.", image: unsplash("photo-1615309662243-70f6df917b59") },
  { slug: "3d-modeling", kind: "3D MODEL", scope: "Architecture, interiors, furniture", tools: "SketchUp, 3ds Max", deliver: "Scaled 3D models", short: "3D Modeling", service: "3D Modeling", headline: "Buildings, interiors and objects, modeled to scale", description: "Accurate architectural, interior and furniture models, ready for any visualization.", image: unsplash("photo-1722876599298-dbdf5c4006f5") },
  { slug: "3ds-max-production", kind: "PRODUCTION", scope: "Scene, materials, lighting", tools: "3ds Max, Corona", deliver: "Render-ready scene", short: "3ds Max Production", service: "3ds Max Production", headline: "Scenes textured and lit, ready to render", description: "See how scenes, materials and lighting are set up in 3ds Max.", image: unsplash("photo-1749834553226-b0f0651a2a96") },
  { slug: "architectural-visualization", kind: "EXTERIOR RENDER", scope: "Exterior, interior, site", tools: "3ds Max, Corona", deliver: "4K marketing stills", short: "Visualization", service: "Architectural Visualization", headline: "Photo-real images before the building exists", description: "Exterior, interior and site visuals that read as photography.", image: unsplash("photo-1633109713362-031e75973c1b") },
  { slug: "animation-motion", kind: "WALKTHROUGH", scope: "Walkthrough, fly-through", tools: "3ds Max, Premiere", deliver: "4K walkthrough", short: "Animation & Motion", service: "Animation & Motion", headline: "Walk through the project on camera", description: "Walkthroughs and fly-throughs that show scale and flow.", image: unsplash("photo-1633109633238-e982d5b61f9f") },
  { slug: "unreal-engine", kind: "REAL-TIME", scope: "Real-time walkthrough", tools: "Unreal Engine", deliver: "Interactive walkthrough", short: "Unreal Engine", service: "Real-time / Unreal Engine", headline: "Explore the design live, in real time", description: "Interactive walkthroughs and virtual showrooms your clients can navigate.", image: unsplash("photo-1633109611134-c41b5c0bbc1a") },
];

const requestHref = "/contact";
// Visuals page: har service ka button yahan le jata hai, jaise /Visuals?service=bim-production
const visualsHref = "/visuals";
const small = (u: string) => u.replace("w=1800&q=85", "w=620&q=72");
const loop = [...gallery, ...gallery]; // entrance marquee: do baar, taake loop beech se na tute
---

<section class="vg" id="visual-gallery" aria-label="Visual gallery">
  <div class="vg-wrap">
    <div class="vg-head">
      <div>
        <span class="vg-tag">PORTFOLIO</span>
        <h2>Walk the <em>gallery.</em></h2>
      </div>
      <p>Step inside. Browse four pieces at a time with the arrows, open any one.</p>
    </div>

    <div class="vg-stage is-intro" id="vgStage" tabindex="0" aria-roledescription="gallery carousel">

      <!-- ENTRANCE: sab cards khud scroll hote hain (Production Layer jaisa), koi text nahi -->
      <div class="vg-marquee" id="vgMarquee">
        <div class="vg-marquee-track">
          {loop.map((item, i) => (
            <button
              class="vg-card"
              data-i={i % gallery.length}
              tabindex={i >= gallery.length ? -1 : undefined}
              aria-hidden={i >= gallery.length ? "true" : undefined}
              aria-label={`Enter the gallery: ${item.service}`}
            >
              <img src={small(item.image)} alt={i >= gallery.length ? "" : item.service} width="270" height="400" loading={i < 5 ? "eager" : "lazy"} decoding="async" draggable="false" />
              <span class="vg-card-overlay"></span>
            </button>
          ))}
        </div>
      </div>

      <!-- GALLERY: ek waqt mein 4 cards, > se agle 4 -->
      <div class="vg-pager" id="vgPager">
        <div class="vg-pager-view">
          <div class="vg-pager-track" id="vgTrack">
            {gallery.map((item, i) => (
              <button class="vg-card" data-i={i} aria-label={`Open ${item.service}`}>
                <img src={small(item.image)} alt={item.service} width="270" height="400" loading="lazy" decoding="async" draggable="false" />
                <span class="vg-card-overlay"></span>
                <span class="vg-card-name">{item.short}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Top-Left Pill Badge -->
      <div class="vg-hud">
        <span id="vgHud">ENTRANCE</span>
      </div>

      <!-- Top-Right Modes -->
      <div class="vg-modes">
        <button id="vgGrid" class="is-on">GRID</button>
        <button id="vgImm"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 5V1h4M11 1h4v4M15 11v4h-4M5 15H1v-4"/></svg>IMMERSIVE</button>
      </div>

      <!-- Center CTA -->
      <div class="vg-enter">
        <button id="vgEnter">Enter the gallery</button>
        <small>CLICK A CARD · USE THE ARROWS</small>
      </div>

      <div class="vg-tip" id="vgTip" aria-hidden="true"><b></b><small></small></div>

      <!-- Bottom Controls -->
      <div class="vg-ctrl">
        <button id="vgPrev" aria-label="Previous"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 3 5 8l5 5"/></svg></button>
        <div class="vg-dots" id="vgDots"></div>
        <button id="vgNext" aria-label="Next"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 3 5 5-5 5"/></svg></button>
      </div>

      <!-- Detail Card -->
      <div class="vg-detail" id="vgDetail" aria-hidden="true">
        <div class="vg-detail-img"><img id="vgDImgA" alt="" class="is-on" /><img id="vgDImgB" alt="" /></div>
        <div class="vg-detail-info">
          <button class="vg-close" id="vgClose" aria-label="Close">✕</button>
          <div class="vg-swap" id="vgSwap">
            <span class="vg-eyebrow" id="vgDKind"></span>
            <h3 id="vgDTitle"></h3>
            <p id="vgDDesc"></p>
            <dl>
              <div><dt>SCOPE</dt><dd id="vgDScope"></dd></div>
              <div><dt>TOOLS</dt><dd id="vgDTools"></dd></div>
              <div><dt>DELIVERABLES</dt><dd id="vgDDeliver"></dd></div>
            </dl>
          </div>
          <div class="vg-actions">
            <a id="vgDVisuals" class="vg-btn-solid" href={visualsHref}>View visuals ↗</a>
            <a id="vgDLink" class="vg-btn-ghost" href={requestHref}>Request similar</a>
            <button id="vgDNext" class="vg-btn-ghost">Next →</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ gallery, requestHref, visualsHref }}>
  const N = gallery.length;
  const GAP = 22;                       // cards ke beech gap (Production Layer jaisa)
  const $ = (id) => document.getElementById(id);
  const stage = $("vgStage"), marquee = $("vgMarquee"), pager = $("vgPager");
  const track = $("vgTrack"), tip = $("vgTip"), detail = $("vgDetail"), dotsEl = $("vgDots");
  const pad = (n) => String(n).padStart(2, "0");

  let idx = 0;            // jis card ki detail khuli hai
  let page = 0;           // abhi konsa "4 cards" ka page dikh raha hai
  let cols = 4, pages = Math.ceil(N / 4), stepPx = 0;
  let mode = "intro", open = false, dragging = false, moved = false;
  let dots = [];

  function buildDots() {
    dotsEl.innerHTML = Array.from({ length: pages }, () => "<i></i>").join("");
    dots = [...dotsEl.children];
  }

  function place() { track.style.setProperty("--px", -page * stepPx + "px"); }

  function ui() {
    const a = page * cols + 1, b = Math.min(N, (page + 1) * cols);
    $("vgHud").textContent = mode === "intro" ? "ENTRANCE" : `${pad(a)}–${pad(b)} / ${pad(N)} · GALLERY`;
    dots.forEach((el, i) => el.classList.toggle("is-on", mode === "walk" && i === page));
    $("vgGrid").classList.toggle("is-on", mode === "intro");
    $("vgImm").classList.toggle("is-on", mode === "walk");
    stage.classList.toggle("is-intro", mode === "intro");
    stage.classList.toggle("is-walk", mode === "walk");
  }

  function resize() {
    const W = stage.clientWidth, H = stage.clientHeight;
    const maxH = Math.max(160, H - 150);          // HUD aur controls ke liye jagah

    // entrance cards (270 x 400, jaise Production Layer)
    const mh = Math.min(400, maxH);
    marquee.style.setProperty("--ch", mh + "px");
    marquee.style.setProperty("--cw", (mh * 270) / 400 + "px");

    // gallery: 4 cards ek saath (chhoti screen par 2)
    cols = W < 520 ? 2 : 4;
    const padX = Math.max(24, Math.min(56, W * 0.04));
    let cw = (W - 2 * padX - (cols - 1) * GAP) / cols;
    let ch = (cw * 400) / 270;
    if (ch > maxH) { ch = maxH; cw = (ch * 270) / 400; }
    const vw = cols * cw + (cols - 1) * GAP;
    pager.style.setProperty("--cw", cw + "px");
    pager.style.setProperty("--ch", ch + "px");
    pager.style.setProperty("--vw", vw + "px");
    stepPx = vw + GAP;

    pages = Math.ceil(N / cols);
    page = Math.min(page, pages - 1);
    buildDots();
    place();
    ui();
  }

  function enterWalk(p) {
    track.classList.add("no-anim");               // pehli baar bina slide ke
    page = Math.max(0, Math.min(pages - 1, p));
    place();
    void track.offsetWidth;
    track.classList.remove("no-anim");
    mode = "walk";
    ui();
  }

  function goPage(p) {
    page = ((p % pages) + pages) % pages;
    place();
    ui();
  }

  const step = (dir) => (mode === "intro" ? enterWalk(0) : goPage(page + dir));

  let imgFlip = false;
  const buildContactHref = (g) => {
    const params = new URLSearchParams({
      service: g.slug,
      subject: g.service,
    });
    return `${requestHref}?${params.toString()}`;
  };

  // Is service ke visuals: Visuals page par ?service=<slug> filter ke saath
  const buildVisualsHref = (g) => `${visualsHref}?${new URLSearchParams({ service: g.slug }).toString()}`;

  function fill() {
    const g = gallery[idx];
    const sw = $("vgSwap");
    sw.classList.remove("hw-swap"); void sw.offsetWidth; sw.classList.add("hw-swap");
    $("vgDKind").textContent = g.kind;
    $("vgDTitle").textContent = g.short;
    $("vgDDesc").textContent = g.description;
    $("vgDScope").textContent = g.scope;
    $("vgDTools").textContent = g.tools;
    $("vgDDeliver").textContent = g.deliver;
    $("vgDLink").href = buildContactHref(g);
    $("vgDVisuals").href = buildVisualsHref(g);
    $("vgDVisuals").setAttribute("aria-label", `View ${g.service} visuals`);
    const nextImg = $(imgFlip ? "vgDImgA" : "vgDImgB"), prevImg = $(imgFlip ? "vgDImgB" : "vgDImgA");
    nextImg.src = g.image; nextImg.alt = g.service;
    nextImg.classList.add("is-on"); prevImg.classList.remove("is-on");
    imgFlip = !imgFlip;
  }
  const openDetail = () => { open = true; fill(); detail.classList.add("is-open"); detail.setAttribute("aria-hidden", "false"); };
  const closeDetail = () => { open = false; detail.classList.remove("is-open"); detail.setAttribute("aria-hidden", "true"); };

  $("vgEnter").addEventListener("click", () => enterWalk(0));
  $("vgGrid").addEventListener("click", () => { closeDetail(); mode = "intro"; ui(); });
  $("vgImm").addEventListener("click", () => { if (mode === "intro") enterWalk(0); });
  $("vgPrev").addEventListener("click", () => step(-1));
  $("vgNext").addEventListener("click", () => step(1));
  $("vgClose").addEventListener("click", closeDetail);
  $("vgDNext").addEventListener("click", () => {
    idx = (idx + 1) % N;
    goPage(Math.floor(idx / cols));
    fill();
  });

  // Entrance: kisi bhi card par click -> gallery mein us card ke page par
  marquee.querySelectorAll(".vg-card").forEach((c) =>
    c.addEventListener("click", () => enterWalk(Math.floor(+c.dataset.i / cols)))
  );
  // Gallery: card par click -> detail
  track.querySelectorAll(".vg-card").forEach((c) =>
    c.addEventListener("click", () => {
      if (moved) return;
      idx = +c.dataset.i;
      openDetail();
    })
  );

  // Swipe (touch / mouse) se bhi agle-pichle 4 cards
  let sx = 0;
  pager.addEventListener("pointerdown", (e) => { dragging = true; moved = false; sx = e.clientX; });
  window.addEventListener("pointermove", (e) => { if (dragging && Math.abs(e.clientX - sx) > 8) moved = true; });
  window.addEventListener("pointerup", (e) => {
    if (!dragging) return;
    dragging = false;
    const dx = e.clientX - sx;
    if (mode === "walk" && !open && Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    setTimeout(() => (moved = false), 0);
  });

  stage.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") step(1);
    else if (e.key === "ArrowLeft") step(-1);
    else if (e.key === "Escape") closeDetail();
  });

  stage.addEventListener("pointermove", (e) => {
    const c = e.target.closest?.(".vg-pager .vg-card");
    if (mode !== "walk" || open || dragging || !c) { tip.classList.remove("is-on"); return; }
    const r = stage.getBoundingClientRect(), g = gallery[+c.dataset.i];
    tip.firstChild.textContent = g.short;
    tip.lastChild.textContent = `${g.service.toUpperCase()} · CLICK TO OPEN`;
    tip.style.transform = `translate(${e.clientX - r.left - 20}px, ${e.clientY - r.top + 10}px)`;
    tip.classList.add("is-on");
  });
  stage.addEventListener("pointerleave", () => tip.classList.remove("is-on"));

  // Section screen par aaye tab entrance animation start, bahar jaye to ruk jaye
  new IntersectionObserver(([en]) => {
    stage.classList.toggle("is-off", !en.isIntersecting);
    if (en.isIntersecting) stage.classList.add("is-ready");
  }, { threshold: 0.15 }).observe(stage);

  new ResizeObserver(resize).observe(stage);
  resize();
</script>