
---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/insights.css";
import "../styles/footer.css";
import { getCollection } from "astro:content";

// Fetch Master Insights Page Header Content
const insightsPageEntries = await getCollection("insightsPage");
const pageData = insightsPageEntries[0]?.data || {
  heroTitle: "Insights / Technical production",
  heroSubtitle: "Practical notes for controlled AEC delivery.",
  heroDescription:
    "Fictional development articles demonstrate the editorial structure. They are not client evidence, legal advice or published thought leadership.",
};

// Fetch All Insight Articles
const articles = await getCollection("insights");

/*
 * High-resolution Architecture Imagery Fallbacks
 */
const q = "?auto=format&fit=crop&w=1400&q=80";
const articleImages = [
  `https://images.unsplash.com/photo-1486406146926-c627a92ad1ab${q}`,
  `https://images.unsplash.com/photo-1600585154340-be6161a56a0c${q}`,
  `https://images.unsplash.com/photo-1487958449943-2429e8be8625${q}`,
  `https://images.unsplash.com/photo-1600596542815-ffad4c1539a9${q}`,
  `https://images.unsplash.com/photo-1518005020951-eccb494ad742${q}`,
  `https://images.unsplash.com/photo-1613977257363-707ba9348227${q}`,
  `https://images.unsplash.com/photo-1497366216548-37526070297c${q}`,
  `https://images.unsplash.com/photo-1600585154526-990dced4db0d${q}`,
];

/* Hero title typography split */
const heroWords = pageData.heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Technical Production Insights | Axys3D" description={pageData.heroDescription} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-insights-list">
    <!-- SUBTLE & LIGHT BACKGROUND GRADIENT -->
    <div class="isl-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="isl-page">
      <!-- ================= HERO ================= -->
      <section class="isl-intro">
        <div class="isl-wrap">
          <div class="isl-intro-row">
            <div class="isl-intro-header">
              <span class="isl-kicker">{pageData.heroTitle}</span>
              <h1 class="isl-h1">
                <span class="isl-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["isl-word", { "isl-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{pageData.heroSubtitle}</span>
              </h1>
              <p class="isl-lead">{pageData.heroDescription}</p>
            </div>

            <!-- AEC INTELLIGENCE VISUAL — STRICTLY WARM BROWN/CHARCOAL (NO BLUE OR GREEN) -->
            <div class="isl-intro-media">
              <svg class="isl-flow" viewBox="0 0 920 540" role="img" aria-label="Axys3D Intelligence Hub Visual" preserveAspectRatio="xMidYMid meet">
                <defs>
                  <linearGradient id="card-dark" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#241b16" stop-opacity="0.96"/>
                    <stop offset="100%" stop-color="#140f0c" stop-opacity="0.98"/>
                  </linearGradient>

                  <radialGradient id="isl-coreGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#8f6444" stop-opacity="0.32"/>
                    <stop offset="100%" stop-color="#8f6444" stop-opacity="0"/>
                  </radialGradient>

                  <filter id="isl-laserGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                    <feMerge>
                      <feMergeNode in="coloredBlur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>
                </defs>

                <!-- Blueprint Grid Lines -->
                <g class="isl-cad-grid" opacity="0.22" stroke="#8f6444" stroke-width="0.8">
                  <path d="M 30 100 H 890 M 30 200 H 890 M 30 300 H 890 M 30 400 H 890" stroke-dasharray="3 9"/>
                  <path d="M 120 30 V 510 M 280 30 V 510 M 460 30 V 510 M 640 30 V 510 M 800 30 V 510" stroke-dasharray="3 9"/>
                  <circle cx="460" cy="270" r="210" stroke="#a07350" stroke-width="1" fill="none" stroke-dasharray="3 7"/>
                  <circle cx="460" cy="270" r="280" stroke="#525254" stroke-width="0.8" fill="none" stroke-dasharray="4 12"/>
                </g>

                <!-- Central Radial Glow -->
                <circle cx="460" cy="270" r="200" fill="url(#isl-coreGlow)"/>

                <!-- Network Beam Lines -->
                <g stroke="rgba(160,115,80,0.3)" stroke-width="1.4">
                  <line x1="150" y1="160" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="150" y1="390" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="770" y1="150" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="770" y1="400" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="460" y1="95" x2="460" y2="270"/>
                </g>

                <!-- Tracking Beams -->
                <path stroke="#8f6444" stroke-width="2.8" stroke-linecap="round" d="M 150 160 Q 290 200 460 270 T 770 400" fill="none" filter="url(#isl-laserGlow)"/>
                <path stroke="#a07350" stroke-width="1.8" stroke-dasharray="4 8" d="M 150 390 Q 300 340 460 270 T 770 150" fill="none"/>

                <!-- CENTRAL KNOWLEDGE HUB -->
                <g transform="translate(460, 270)">
                  <circle class="isl-orbit-ring" r="75" fill="none" stroke="#a07350" stroke-width="1.5" stroke-dasharray="10 6" opacity="0.8"/>
                  <circle r="52" fill="url(#card-dark)" stroke="#8f6444" stroke-width="2"/>
                  <circle r="34" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" stroke-dasharray="4 4"/>
                  <circle r="7" fill="#a07350" class="isl-pulse-sensor"/>
                  <polygon points="0,-18 16,-9 16,9 0,18 -16,9 -16,-9" fill="none" stroke="#ffffff" stroke-width="1.5"/>
                  
                  <g transform="translate(0, 86)" text-anchor="middle">
                    <text fill="#a07350" font-family="monospace" font-size="8.5" font-weight="700" letter-spacing="0.14em">AXYS3D INTELLIGENCE</text>
                    <text fill="#e5e2de" font-family="sans-serif" font-size="9" font-weight="600" y="14">KNOWLEDGE & ADVISORY HUB</text>
                  </g>
                </g>

                <!-- TOP LEFT: METHODOLOGY (Warm & White) -->
                <g transform="translate(150, 160)">
                  <circle r="26" fill="none" stroke="#8f6444" stroke-width="1.2" opacity="0.5"/>
                  <circle r="5" fill="#a07350"/>
                  <g class="isl-hover-float" transform="translate(0, -32)">
                    <rect x="-75" y="-32" width="150" height="48" rx="10" fill="url(#card-dark)" stroke="#8f6444" stroke-width="1.5"/>
                    <text x="-60" y="-12" fill="#a07350" font-size="9" font-family="monospace" font-weight="bold">METHODOLOGY</text>
                    <text x="-60" y="4" fill="#ffffff" font-size="10.5" font-family="sans-serif" font-weight="700">LOD 350+ Standards</text>
                    <circle cx="56" cy="-9" r="9" fill="#8f6444" fill-opacity="0.3" stroke="#a07350" stroke-width="1.2"/>
                    <path d="M 53 -9 L 55 -7 L 59 -11" fill="none" stroke="#ffffff" stroke-width="1.5"/>
                  </g>
                </g>

                <!-- BOTTOM LEFT: DELIVERY NETWORK (Charcoal & Warm Bronze) -->
                <g transform="translate(150, 390)">
                  <circle r="26" fill="none" stroke="#525254" stroke-width="1.2" opacity="0.5"/>
                  <circle r="5" fill="#525254"/>
                  <g class="isl-hover-float" style="animation-delay: -1.5s" transform="translate(0, 40)">
                    <rect x="-75" y="-16" width="150" height="48" rx="10" fill="url(#card-dark)" stroke="rgba(255,255,255,0.2)" stroke-width="1.2"/>
                    <text x="-60" y="2" fill="#959595" font-size="8.5" font-family="monospace">DELIVERY NETWORK</text>
                    <text x="-60" y="18" fill="#ffffff" font-size="10" font-family="sans-serif" font-weight="600">Architects & Consultants</text>
                  </g>
                </g>

                <!-- TOP RIGHT: AUDITED IMPACT (Old Green Replaced with Warm Bronze) -->
                <g transform="translate(770, 150)">
                  <circle r="26" fill="none" stroke="#a07350" stroke-width="1.2" opacity="0.5"/>
                  <circle r="5" fill="#a07350"/>
                  <g class="isl-hover-float" style="animation-delay: -0.8s" transform="translate(0, -32)">
                    <rect x="-75" y="-32" width="150" height="48" rx="10" fill="url(#card-dark)" stroke="#a07350" stroke-width="1.5"/>
                    <text x="-60" y="-12" fill="#a07350" font-size="9" font-family="monospace" font-weight="bold">AUDITED IMPACT</text>
                    <text x="-60" y="4" fill="#ffffff" font-size="10.5" font-family="sans-serif" font-weight="700">40% Efficiency Gain</text>
                    <circle cx="56" cy="-9" r="9" fill="#a07350" fill-opacity="0.25" stroke="#a07350" stroke-width="1.2"/>
                    <path d="M 53 -9 L 55 -7 L 59 -11" fill="none" stroke="#ffffff" stroke-width="1.5"/>
                  </g>
                </g>

                <!-- BOTTOM RIGHT: EXECUTION FRAMEWORK (Old Blue Replaced with Bronze) -->
                <g transform="translate(770, 400)">
                  <circle r="26" fill="none" stroke="#8f6444" stroke-width="1.2" opacity="0.5"/>
                  <circle r="5" fill="#8f6444"/>
                  <g class="isl-hover-float" style="animation-delay: -2.2s" transform="translate(0, 40)">
                    <rect x="-75" y="-16" width="150" height="48" rx="10" fill="url(#card-dark)" stroke="rgba(143,100,68,0.5)" stroke-width="1.2"/>
                    <text x="-60" y="2" fill="#c9ad90" font-size="8.5" font-family="monospace">EXECUTION FRAMEWORK</text>
                    <text x="-60" y="18" fill="#ffffff" font-size="10" font-family="sans-serif" font-weight="600">Controlled Handover</text>
                  </g>
                </g>

                <!-- TOP CENTER BADGE (Warm Brown Accent) -->
                <g transform="translate(460, 85)">
                  <rect x="-80" y="-18" width="160" height="32" rx="16" fill="#18120e" stroke="#8f6444" stroke-width="1.2"/>
                  <circle cx="-60" cy="0" r="3.5" fill="#a07350" class="isl-pulse-sensor"/>
                  <text x="-46" y="3.5" fill="#ffffff" font-size="9" font-family="monospace" letter-spacing="0.08em">LIVE AEC INSIGHTS</text>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= ARTICLES (NEECHE SHIFT KIYA GAYA) ================= -->
      <section class="isl-cards-sec" id="articles">
        <div class="isl-wrap">
          <div class="isl-sec-head--row" data-reveal>
            <div>
              <span class="isl-kicker">LATEST ARTICLES</span>
              <h2 class="isl-sec-h2">Latest reading <br /><span>from our team.</span></h2>
            </div>
          </div>

          {articles.length > 0 ? (
            <div class="isl-cards-grid">
              {articles.map((article, i) => (
                <a
                  class="isl-card"
                  href={`/insights/${article.id}`}
                  data-reveal
                  style={`--d: ${(i % 2) * 120}ms`}
                  aria-label={`${article.data.title} — ${article.data.ctaLabel}`}
                >
                  <img
                    src={(article.data as any).image ?? articleImages[i % articleImages.length]}
                    alt=""
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                    draggable="false"
                  />
                  <div class="isl-card-overlay"></div>

                  <div class="isl-card-top">
                    <span class="isl-card-meta">
                      {article.data.category} / {article.data.readTime}
                    </span>
                    <span class="isl-card-badge">{article.data.badgeText}</span>
                  </div>

                  <div class="isl-card-body">
                    <h3 class="isl-card-title">{article.data.title}</h3>
                    <p class="isl-card-desc">{article.data.summary}</p>
                    <span class="isl-card-cta">
                      <span class="isl-card-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </span>
                      <span class="isl-card-cta-label">{article.data.ctaLabel}</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p style="text-align: center; color: #959595; padding: 60px 0;">No articles found in src/content/insights/</p>
          )}
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="isl-final-cta">
        <div class="isl-wrap">
          <div class="isl-final-inner" data-reveal>
            <h2>Have a question? <br /><span>Let's talk production.</span></h2>
            <p>Tell us what you're working on and we'll point you to the right technical approach.</p>
            <a href="/contact" class="isl-final-button">
              <span>Get in touch</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));
    </script>
  </body>
</html>