// ⬇⬇ SIRF YAHAN IMAGE LINKS BADLO (https://... ya /images/... dono chalte hain) ⬇⬇
const orbitImages = {
  bim: "https://images.unsplash.com/photo-1627141234469-24711efb373c?auto=format&fit=crop&w=400&h=400&q=75",
  revit: "https://images.unsplash.com/photo-1721244654392-9c912a6eb236?auto=format&fit=crop&w=400&h=400&q=75",
  mep: "https://images.unsplash.com/photo-1765850262030-1ae93e474473?auto=format&fit=crop&w=400&h=400&q=75",
  max3ds: "https://images.unsplash.com/photo-1726471809607-b7f016a1696e?auto=format&fit=crop&w=400&h=400&q=75",
  motion: "https://images.unsplash.com/photo-1722421492323-eaf9c401befe?auto=format&fit=crop&w=400&h=400&q=75",
  unreal: "https://images.unsplash.com/photo-1706808849780-7a04fbac83ef?auto=format&fit=crop&w=400&h=400&q=75",
  visualization: "https://images.unsplash.com/photo-1706808849802-8f876ade0d1f?auto=format&fit=crop&w=400&h=400&q=75",
  model3d: "https://images.unsplash.com/photo-1503387837-b154d5074bd2?auto=format&fit=crop&w=400&h=400&q=75",
};

/* =========================================================
   SERVICE PANELS — data
   Har service ka: slug (detail page /services/<slug>), image, aur "includes" (andar kya kya aata hai).
   Images upar wali orbitImages se aati hain (wohi relevant images), bas bari size mein.
   Kisi service ki image badalni ho to sirf us ka `image` link badlo.
   ========================================================= */

const thumb = (u: string) => u.replace(/w=\d+&h=\d+&q=\d+/, "w=600&h=800&q=75");

const services = [
  {
    num: "01",
    slug: "bim-production",
    title: "BIM Execution & Model Production",
    blurb:
      "Coordinated BIM models built to firm standards, from concept development through construction-ready detail.",
    includes: ["BIM Modeling", "Model Development", "Model Setup & Standards"],
    image: thumb(orbitImages.bim),
  },
  {
    num: "02",
    slug: "revit-production",
    title: "Revit Production & Documentation",
    blurb:
      "Production-ready Revit documentation and drawing sets, coordinated across disciplines and issued on schedule.",
    includes: ["Construction Drawings", "Revit Documentation", "Drawing Coordination"],
    image: thumb(orbitImages.revit),
  },
  {
    num: "03",
    slug: "mep-coordination",
    title: "MEP Coordination Support",
    blurb:
      "Clash-checked mechanical, electrical and plumbing coordination that keeps every system resolved before it hits site.",
    includes: ["Mechanical", "Electrical", "Plumbing"],
    image: thumb(orbitImages.mep),
  },
  {
    num: "04",
    slug: "3d-modeling",
    title: "3D Modeling",
    blurb:
      "Accurate architectural, interior and object models built to support every downstream visualization need.",
    includes: ["Architectural Modeling", "Interior Modeling", "Furniture & Objects"],
    image: thumb(orbitImages.model3d),
  },
  {
    num: "05",
    slug: "3ds-max-production",
    title: "3ds Max Production",
    blurb: "Scene setup, materials and lighting built in 3ds Max to a consistent, production-grade pipeline.",
    includes: ["Scene Setup", "Materials & Texturing", "Lighting & Camera"],
    image: thumb(orbitImages.max3ds),
  },
  {
    num: "06",
    slug: "architectural-visualization",
    title: "Architectural Visualization",
    blurb: "Exterior, interior and site visualizations that read as photography long before the building exists.",
    includes: ["Exterior Visualization", "Interior Visualization", "Site Visualization"],
    image: thumb(orbitImages.visualization),
  },
  {
    num: "07",
    slug: "animation-motion",
    title: "Animation & Motion",
    blurb: "Walkthroughs, fly-throughs and camera sequences that move a project through space with intent.",
    includes: ["Walkthroughs", "Fly-through Animations", "Camera & Motion"],
    image: thumb(orbitImages.motion),
  },
  {
    num: "08",
    slug: "real-time",
    title: "Real-time / Unreal Engine",
    blurb:
      "Real-time environments in Unreal Engine — interactive walkthroughs and virtual showrooms your clients can explore.",
    includes: ["Interactive Walkthroughs", "Real-time Visualization", "Virtual Showrooms"],
    image: thumb(orbitImages.unreal),
  },
];

/* =========================================================
   HERO CARD — "What we deliver"
   8 services ko 3 stages mein dikhata hai. Naam / line badalni ho to sirf yahan badlo.
   Icon = simple SVG path (24x24 grid).
   ========================================================= */
const serviceMeta: Record<string, { name: string; deliver: string; icon: string }> = {
  "bim-production": {
    name: "BIM Production",
    deliver: "Coordinated, standards-based BIM models",
    icon: "M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z M12 12l8-4.5 M12 12v9 M12 12L4 7.5",
  },
  "revit-production": {
    name: "Revit Documentation",
    deliver: "Construction drawing sets, on schedule",
    icon: "M5 3h14v18H5z M9 8h6 M9 12h6 M9 16h3",
  },
  "mep-coordination": {
    name: "MEP Coordination",
    deliver: "Clash-checked mechanical, electrical, plumbing",
    icon: "M3 7h10a4 4 0 014 4v10 M3 13h5 M17 3v4",
  },
  "3d-modeling": {
    name: "3D Modeling",
    deliver: "Architecture, interiors, furniture & objects",
    icon: "M12 3l8 4-8 4-8-4 8-4z M4 12l8 4 8-4 M4 16.5l8 4 8-4",
  },
  "3ds-max-production": {
    name: "3ds Max Production",
    deliver: "Scenes, materials & lighting, render-ready",
    icon: "M12 8a4 4 0 100 8 4 4 0 000-8z M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4",
  },
  "architectural-visualization": {
    name: "Architectural Visualization",
    deliver: "Photoreal exterior, interior & site images",
    icon: "M6 21V4h12v17 M3 21h18 M10 8h4 M10 12h4 M10 16h4",
  },
  "animation-motion": {
    name: "Animation & Motion",
    deliver: "Walkthroughs & fly-through films",
    icon: "M3 6h12v12H3z M15 10l6-3v10l-6-3",
  },
  "real-time": {
    name: "Real-time / Unreal",
    deliver: "Interactive walkthroughs & virtual showrooms",
    icon: "M3 4h18v12H3z M8 20h8 M12 16v4 M10 7.5l4.5 2.5-4.5 2.5z",
  },
};

/* =========================================================
   HERO VISUAL — "Idea -> Build -> Visualize -> Experience"
   Ek isometric building khud ban-ti hai (wireframe + MEP) -> render hoti hai (rang, khidkiyan, roshni)
   -> camera us ke gird ghoomta hai. 8 services ke icons aas-paas hain, apne stage mein jagmagate hain.
   Geometry neeche code se banti hai, kuch hath se likhne ki zaroorat nahi.
   Icons ki positions badalni hon to sirf vizNodes mein x / y (%) badlo.
   ========================================================= */
type P = [number, number];
const U: P = [26, -15];
const V: P = [-26, -15];
const add = (a: P, d: P, k = 1): P => [a[0] + d[0] * k, a[1] + d[1] * k];
const up = (p: P, h: number): P => [p[0], p[1] - h];
const pts = (a: P[]) => a.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

function makeBox(F: P, dx: number, dy: number, H: number, rows: number, colsR: number, colsL: number) {
  const R = add(F, U, dx);
  const L = add(F, V, dy);
  const B = add(R, V, dy);
  const at = (side: "l" | "r", s: number, hf: number): P =>
    side === "r" ? up(add(F, U, s * dx), H * hf) : up(add(F, V, s * dy), H * hf);
  const wins: string[] = [];
  const addWins = (side: "l" | "r", cols: number) => {
    for (let r = 0; r < rows; r++)
      for (let c = 0; c < cols; c++) {
        const s0 = (c + 0.2) / cols, s1 = (c + 0.8) / cols;
        const h0 = (r + 0.25) / rows, h1 = (r + 0.7) / rows;
        wins.push(pts([at(side, s0, h0), at(side, s1, h0), at(side, s1, h1), at(side, s0, h1)]));
      }
  };
  addWins("r", colsR);
  addWins("l", colsL);
  const floors: string[] = [];
  for (let r = 1; r < rows; r++) floors.push(pts([up(L, (H * r) / rows), up(F, (H * r) / rows), up(R, (H * r) / rows)]));
  return {
    right: pts([F, R, up(R, H), up(F, H)]),
    left: pts([F, L, up(L, H), up(F, H)]),
    top: pts([up(F, H), up(R, H), up(B, H), up(L, H)]),
    floors,
    wins,
    at,
  };
}

const tower = makeBox([300, 420], 3, 3, 220, 8, 3, 3);
const podium = makeBox([386, 444], 3, 2, 96, 3, 3, 2);

const mep = [
  { c: "blue", d: pts([tower.at("l", 1, 0.28), tower.at("l", 0, 0.28), tower.at("r", 0.75, 0.28)]) },
  { c: "red", d: pts([tower.at("l", 1, 0.56), tower.at("l", 0.35, 0.56), tower.at("l", 0.35, 0.86), tower.at("l", 0.75, 0.86)]) },
  { c: "gold", d: pts([tower.at("r", 0.15, 0), tower.at("r", 0.15, 1)]) },
  { c: "gold", d: pts([tower.at("r", 0.15, 0.42), tower.at("r", 0.9, 0.42)]) },
  { c: "blue", d: pts([podium.at("l", 1, 0.4), podium.at("l", 0, 0.4), podium.at("r", 0.8, 0.4)]) },
];

// zameen ka iso grid
const gridLines: string[] = [];
{
  const O: P = [300, 535], N = 10;
  for (let i = 0; i <= N; i++) {
    const a1 = add(O, V, i), a2 = add(a1, U, N);
    const b1 = add(O, U, i), b2 = add(b1, V, N);
    gridLines.push(`M${a1[0]},${a1[1]}L${a2[0]},${a2[1]}`, `M${b1[0]},${b1[1]}L${b2[0]},${b2[1]}`);
  }
}

// icons: g = stage (a Build, b Visualize, c Experience), x/y = % position, side = tooltip direction
const vizNodes = [
  { slug: "bim-production", g: "a", x: 6, y: 14, side: "r", tx: 245, ty: 270 },
  { slug: "revit-production", g: "a", x: 6, y: 38, side: "r", tx: 245, ty: 305 },
  { slug: "mep-coordination", g: "a", x: 6, y: 62, side: "r", tx: 245, ty: 340 },
  { slug: "3d-modeling", g: "b", x: 94, y: 14, side: "l", tx: 355, ty: 270 },
  { slug: "3ds-max-production", g: "b", x: 94, y: 38, side: "l", tx: 355, ty: 300 },
  { slug: "architectural-visualization", g: "b", x: 94, y: 62, side: "l", tx: 355, ty: 330 },
  { slug: "animation-motion", g: "c", x: 24, y: 93, side: "t", tx: 285, ty: 440 },
  { slug: "real-time", g: "c", x: 76, y: 93, side: "t", tx: 330, ty: 452 },
].map((n) => ({ ...n, ...serviceMeta[n.slug], x1: (n.x * 6).toFixed(1), y1: (n.y * 5.6).toFixed(1) }));

const stages = [
  { g: "a", label: "Build" },
  { g: "b", label: "Visualize" },
  { g: "c", label: "Experience" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title="AEC Production Services: BIM, Revit, Visualization | Axys3D"
      description="BIM, Revit, MEP coordination, 3D modeling, visualization, animation and real-time production services for architecture, engineering and development teams."
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-services">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="svc-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="services-page">
      <!-- ================= HERO ================= -->
      <section class="svc-intro">
        <div class="svc-wrap">
          <div class="svc-intro-row">
            <div class="svc-intro-header">
              <span class="svc-kicker">Services</span>
              <h1 class="svc-h1">
                <span class="svc-h1-visual" aria-hidden="true">
                  <span class="svc-word" style="--i:0">AEC</span>
                  <span class="svc-word" style="--i:1">production</span>
                  <br />
                  <span class="svc-word svc-word--muted" style="--i:2">without</span>
                  <span class="svc-word svc-word--muted" style="--i:3">the</span>
                  <span class="svc-word svc-word--muted" style="--i:4">friction.</span>
                </span>
                <span class="sr-only">AEC production without the friction.</span>
              </h1>
              <p class="svc-lead">
                Axys3D provides integrated AEC production support across BIM, Revit, coordination,
                visualization, animation and real-time workflows.
              </p>
            </div>

            <div class="svc-intro-media">
              <div class="svc-viz" role="navigation" aria-label="Services overview">
                <svg class="svc-viz-svg" viewBox="0 0 600 560" aria-hidden="true" focusable="false">
                  <defs>
                    <linearGradient id="vzR" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#5c5c5c" />
                      <stop offset="1" stop-color="#262626" />
                    </linearGradient>
                    <linearGradient id="vzL" x1="1" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#3b3b3b" />
                      <stop offset="1" stop-color="#141414" />
                    </linearGradient>
                    <linearGradient id="vzT" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#a07350" />
                      <stop offset="1" stop-color="#5b3b27" />
                    </linearGradient>
                    <radialGradient id="vzSunG">
                      <stop offset="0" stop-color="#8f6444" stop-opacity="0.55" />
                      <stop offset="1" stop-color="#8f6444" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="vzFade">
                      <stop offset="0.35" stop-color="#fff" />
                      <stop offset="1" stop-color="#000" />
                    </radialGradient>
                    <mask id="vzMask"><rect width="600" height="560" fill="url(#vzFade)" /></mask>
                  </defs>

                  <g class="vz-sun"><circle cx="480" cy="110" r="170" fill="url(#vzSunG)" /></g>

                  <g class="vz-grid" mask="url(#vzMask)">{gridLines.map((d) => <path d={d} />)}</g>

                  <g class="vz-links">
                    {vizNodes.map((n) => (
                      <line class={`vz-link vz-l-${n.g}`} x1={n.x1} y1={n.y1} x2={n.tx} y2={n.ty} />
                    ))}
                  </g>

                  <g class="vz-orbit"><path class="vz-orbit-path" d="M70,385 A230,120 0 0 1 530,385" /></g>

                  <!-- TOWER -->
                  <g class="vz-fill">
                    <polygon points={tower.left} fill="url(#vzL)" />
                    <polygon points={tower.right} fill="url(#vzR)" />
                    <polygon points={tower.top} fill="url(#vzT)" />
                  </g>
                  <g class="vz-wires">
                    <polygon class="vz-wire vz-wa" pathLength="1" points={tower.left} />
                    <polygon class="vz-wire vz-wa" pathLength="1" points={tower.right} />
                    <polygon class="vz-wire vz-wa" pathLength="1" points={tower.top} />
                    {tower.floors.map((f) => <polyline class="vz-wire vz-wb" pathLength="1" points={f} />)}
                  </g>
                  <g class="vz-mepg">
                    {mep.slice(0, 4).map((m) => <polyline class={`vz-mep vz-mep-${m.c}`} pathLength="1" points={m.d} />)}
                  </g>
                  <g class="vz-win">
                    {tower.wins.map((w, i) => <polygon points={w} style={`--w:${((i * 37) % 17) / 6}s`} />)}
                  </g>

                  <!-- PODIUM -->
                  <g class="vz-occ">
                    <polygon points={podium.left} />
                    <polygon points={podium.right} />
                    <polygon points={podium.top} />
                  </g>
                  <g class="vz-fill">
                    <polygon points={podium.left} fill="url(#vzL)" />
                    <polygon points={podium.right} fill="url(#vzR)" />
                    <polygon points={podium.top} fill="url(#vzT)" />
                  </g>
                  <g class="vz-wires">
                    <polygon class="vz-wire vz-wa" pathLength="1" points={podium.left} />
                    <polygon class="vz-wire vz-wa" pathLength="1" points={podium.right} />
                    <polygon class="vz-wire vz-wa" pathLength="1" points={podium.top} />
                    {podium.floors.map((f) => <polyline class="vz-wire vz-wb" pathLength="1" points={f} />)}
                  </g>
                  <g class="vz-mepg">
                    <polyline class={`vz-mep vz-mep-${mep[4].c}`} pathLength="1" points={mep[4].d} />
                  </g>
                  <g class="vz-win">
                    {podium.wins.map((w, i) => <polygon points={w} style={`--w:${((i * 29) % 13) / 5}s`} />)}
                  </g>

                  <!-- CAMERA ORBIT (front half + moving camera) -->
                  <g class="vz-orbit"><path class="vz-orbit-path" d="M530,385 A230,120 0 0 1 70,385" /></g>
                  <g class="vz-orbit vz-cam">
                    <g>
                      <animate attributeName="opacity" dur="7s" repeatCount="indefinite" calcMode="discrete" keyTimes="0;0.5" values="0.35;1" />
                      <circle r="3.5" fill="#a07350" fill-opacity="0.25">
                        <animateMotion dur="7s" begin="-0.4s" repeatCount="indefinite" path="M70,385 A230,120 0 0 1 530,385 A230,120 0 0 1 70,385" />
                      </circle>
                      <circle r="5" fill="#a07350" fill-opacity="0.5">
                        <animateMotion dur="7s" begin="-0.2s" repeatCount="indefinite" path="M70,385 A230,120 0 0 1 530,385 A230,120 0 0 1 70,385" />
                      </circle>
                      <circle r="7.5" fill="#a07350" class="vz-cam-dot">
                        <animateMotion dur="7s" repeatCount="indefinite" path="M70,385 A230,120 0 0 1 530,385 A230,120 0 0 1 70,385" />
                      </circle>
                    </g>
                  </g>
                </svg>

                {vizNodes.map((n) => (
                  <a
                    href={`#${n.slug}`}
                    class={`vz-node vz-g-${n.g} vz-side-${n.side}`}
                    style={`left:${n.x}%;top:${n.y}%`}
                    aria-label={n.name}
                    data-label={n.name}
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={n.icon} />
                    </svg>
                  </a>
                ))}
              </div>

              <div class="svc-viz-stages" aria-hidden="true">
                {stages.map((s) => (
                  <span class={`vz-st vz-st-${s.g}`}><i></i><b>{s.label}</b></span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= SERVICES GRID (4 rows x 2 columns) =================
           Har card: number | image | title + text. Card par click -> /services/<slug>. -->
      <section class="svc-list" aria-label="Our services">
        <div class="svc-wrap">
          <h2 class="sr-only">Our services</h2>
          <div class="svc-grid">
            {[services.slice(0, 4), services.slice(4)].map((col) => (
              <div class="svc-col">
                {col.map((s, idx) => (
                  <article
                    class={`svc-card${idx === 0 ? " is-open" : ""}`}
                    id={s.slug}
                    data-reveal
                    style={`--d:${idx * 0.08}s`}
                  >
                    <span class="svc-card-num">{s.num}</span>
                    <div class="svc-card-media">
                      <img
                        src={s.image}
                        alt={`${s.title} — ${s.includes.join(", ")}`}
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none'"
                      />
                    </div>
                    <div class="svc-card-body">
                      <h3 class="svc-card-title">{s.title}</h3>
                      <div class="svc-card-more">
                        <div class="svc-card-more-inner">
                          <p class="svc-card-blurb">{s.blurb}</p>
                          <p class="svc-card-tags">{s.includes.map((t) => <span>{t}</span>)}</p>
                          <a href={`/services/${s.slug}`} class="svc-card-link" aria-label={`Explore ${s.title}`}>
                            <span>Explore service</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="svc-final-cta">
        <div class="svc-wrap">
          <div class="svc-final-inner" data-reveal>
            <h2>Bring us the <br /><span>production problem.</span></h2>
            <p>Tell us where the project stands and what needs to move next. We'll help define the right production package.</p>
            <a href="/contact" class="final-cta-button">
              <span>Discuss a production package</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Reveal on scroll (panel text + final CTA)
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      /* ===== Service cards: ek column mein ek hi card bara hota hai (hover / focus / tap) ===== */
      document.querySelectorAll(".svc-col").forEach((col) => {
        const cards = Array.from(col.querySelectorAll(".svc-card"));
        const open = (card) => cards.forEach((c) => c.classList.toggle("is-open", c === card));
        cards.forEach((card) => {
          let t;
          card.addEventListener("mouseenter", () => {
            if (!window.matchMedia("(hover: hover)").matches) return;
            clearTimeout(t);
            t = setTimeout(() => open(card), 70); // halka delay: flicker na ho
          });
          card.addEventListener("mouseleave", () => clearTimeout(t));
          card.addEventListener("focusin", () => open(card));
          card.addEventListener("click", (e) => {
            if (!e.target.closest("a")) open(card);
          });
        });
      });

    </script>
  </body>
</html>