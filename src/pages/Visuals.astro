const heroTitle = "Visual Asset Library";
const heroSubtitle = "Explore production assets & renders.";
const heroDescription =
  "A curated archive of photorealistic visual sets, BIM coordination models, and interactive real-time environments.";

/* DITO Sphere Setup from about.astro */
const sphereImages = [
  "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=320&q=70",
  "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=320&q=70",
];

const SPHERE_COLS = 30;
const SPHERE_ROWS = 5;
const SPHERE_ROW_STEP = 12;

const blobShapes = [
  "52% 48% 55% 45% / 48% 54% 46% 52%",
  "46% 54% 48% 52% / 55% 45% 55% 45%",
  "58% 42% 50% 50% / 46% 52% 48% 54%",
  "50% 50% 44% 56% / 54% 46% 54% 46%",
  "44% 56% 52% 48% / 50% 58% 42% 50%",
  "55% 45% 47% 53% / 44% 50% 50% 56%",
];

const sphereTiles: { yaw: number; pitch: number; src: string; shape: string; n: number }[] = [];
for (let c = 0; c < SPHERE_COLS; c++) {
  for (let r = 0; r < SPHERE_ROWS; r++) {
    const stagger = c % 2 ? 0.25 : -0.25;
    sphereTiles.push({
      yaw: c * (360 / SPHERE_COLS),
      pitch: (r - (SPHERE_ROWS - 1) / 2 + stagger) * SPHERE_ROW_STEP,
      src: sphereImages[(c * 3 + r * 2) % sphereImages.length],
      shape: blobShapes[(c * 5 + r * 7) % blobShapes.length],
      n: c * SPHERE_ROWS + r,
    });
  }
}

/* Hero title typography formatting */
const heroWords = heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Visual Asset Library | Axys3D" description={heroDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-visual-library">
    <div class="lib-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="library-page">
      <!-- ================= HERO ================= -->
      <section class="lib-intro">
        <div class="lib-wrap">
          <div class="lib-intro-row">
            <div class="lib-intro-header">
              <span class="lib-kicker">{heroTitle}</span>
              <h1 class="lib-h1">
                <span class="lib-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["lib-word", { "lib-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{heroSubtitle}</span>
              </h1>
              <p class="lib-lead">{heroDescription}</p>
            </div>

            <!-- DITO 3D Sphere from about.astro -->
            <div class="lib-intro-media">
              <div
                class="ind-sphere-stage"
                data-sphere
                role="img"
                aria-label="Interactive rotating gallery"
              >
                <div class="ind-sphere">
                  {sphereTiles.map((t) => (
                    <span
                      class="ind-tile"
                      style={`--yaw:${t.yaw}deg;--pitch:${t.pitch}deg;--n:${t.n};border-radius:${t.shape}`}
                    >
                      <img
                        src={t.src}
                        alt=""
                        loading="eager"
                        decoding="async"
                        draggable="false"
                      />
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= LIBRARY SECTION ================= -->
      <section class="lib-section" id="visual-library">
        <div class="lib-wrap">
          <div class="lib-sec-head lib-sec-head--row" data-reveal>
            <div>
              <span class="lib-kicker">BROWSE THE ARCHIVE</span>
              <h2 class="lib-sec-h2">Every asset, <br /><span>organised by discipline.</span></h2>
            </div>
          </div>

          <!-- Filters -->
          <div class="lib-filters" data-reveal>
            {libraryCategories.map((cat, idx) => (
              <button
                type="button"
                class:list={["lib-filter", { "is-active": idx === 0 }]}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Gallery -->
          <div class="lib-grid" id="libraryGrid">
            {assets.map((item, i) => (
              <div
                class="lib-card"
                role="button"
                tabindex="0"
                data-reveal
                data-category={item.category}
                data-img={item.image}
                data-title={item.title}
                style={`--d: ${(i % 3) * 110}ms`}
                aria-label={`View ${item.title}`}
              >
                <img src={item.image} alt={item.title} loading={i < 3 ? "eager" : "lazy"} decoding="async" draggable="false" />
                <div class="lib-card-overlay"></div>
                <div class="lib-card-shine"></div>

                <div class="lib-card-top">
                  <span class="lib-card-cat">{item.category}</span>
                  <span class="lib-card-tag">{item.tag}</span>
                </div>

                <div class="lib-card-body">
                  <h3 class="lib-card-title">{item.title}</h3>
                  <span class="lib-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
                  </span>
                </div>
              </div>
            ))}
          </div>

          <p class="lib-empty" id="libEmpty">No assets in this category yet.</p>
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="lib-final-cta">
        <div class="lib-wrap">
          <div class="lib-final-inner" data-reveal>
            <h2>Need a custom visual set? <br /><span>Let's build it together.</span></h2>
            <p>Tell us what you're working on and we'll scope the right production package.</p>
            <a href="/contact" class="lib-final-button">
              <span>Discuss a project</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <!-- Lightbox -->
    <div class="lib-lightbox" id="lightboxModal" role="dialog" aria-modal="true" aria-label="Asset preview">
      <button type="button" class="lib-lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
      <div class="lib-lightbox-inner">
        <img id="lightboxImg" src="" alt="" />
        <div id="lightboxCaption" class="lib-lightbox-caption"></div>
      </div>
    </div>

    <script is:inline>
      const pad = (n) => String(n).padStart(2, "0");

      // Reveal on scroll
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -30px 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealObserver.observe(el));

      // Grid + filters
      const filterBtns = Array.from(document.querySelectorAll(".lib-filter"));
      const cards = Array.from(document.querySelectorAll(".lib-card"));
      const emptyEl = document.getElementById("libEmpty");
      const mqTablet = window.matchMedia("(max-width: 1024px)");
      const mqMobile = window.matchMedia("(max-width: 640px)");
      let currentCategory = "All";

      const columns = () => (mqMobile.matches ? 1 : mqTablet.matches ? 2 : 3);

      const layout = () => {
        const visible = cards.filter((c) => c.style.display !== "none");
        const cols = columns();
        const base = 6 / cols;
        const rest = visible.length % cols;
        visible.forEach((c, i) => {
          let span = base;
          if (rest > 0 && i >= visible.length - rest) span = 6 / rest;
          c.style.gridColumn = `span ${span}`;
        });
      };

      const applyFilter = (category, animate = true) => {
        currentCategory = category;
        filterBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.category === category));

        let k = 0;
        cards.forEach((card) => {
          const show = category === "All" || card.dataset.category === category;
          card.style.display = show ? "" : "none";
          if (show && animate) {
            card.classList.remove("lib-pop");
            void card.offsetWidth;
            card.style.setProperty("--k", k++);
            card.classList.add("lib-pop");
            card.classList.add("is-visible");
          }
        });

        const shown = cards.filter((c) => c.style.display !== "none").length;
        emptyEl.classList.toggle("is-shown", shown === 0);
        layout();
        if (animate) setTimeout(() => cards.forEach((c) => c.classList.remove("lib-pop")), 1400);
      };

      filterBtns.forEach((btn) =>
        btn.addEventListener("click", () => applyFilter(btn.dataset.category || "All"))
      );
      mqTablet.addEventListener("change", layout);
      mqMobile.addEventListener("change", layout);

      const categoryFromUrl = new URLSearchParams(window.location.search).get("category");
      if (categoryFromUrl && filterBtns.some((b) => b.dataset.category === categoryFromUrl)) {
        applyFilter(categoryFromUrl, false);
        document.getElementById("visual-library")?.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        layout();
      }

      cards.forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      // Lightbox
      const lightbox = document.getElementById("lightboxModal");
      const lightboxImg = document.getElementById("lightboxImg");
      const lightboxCaption = document.getElementById("lightboxCaption");
      const closeBtn = document.getElementById("lightboxClose");

      const openBox = (card) => {
        lightboxImg.src = card.dataset.img || "";
        lightboxImg.alt = card.dataset.title || "";
        lightboxCaption.textContent = card.dataset.title || "";
        lightbox.classList.add("is-open");
        document.body.style.overflow = "hidden";
      };
      const closeBox = () => {
        lightbox.classList.remove("is-open");
        document.body.style.overflow = "";
      };

      cards.forEach((card) => {
        card.addEventListener("click", () => openBox(card));
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openBox(card);
          }
        });
      });
      closeBtn.addEventListener("click", closeBox);
      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeBox();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeBox();
      });

      /* DITO Sphere Animation Script from about.astro */
      (() => {
        const stage = document.querySelector("[data-sphere]");
        if (!stage) return;
        const sphere = stage.querySelector(".ind-sphere");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let R = 300;
        const layout = () => {
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H) return;
          R = Math.min(W * 0.52, H * 0.9);
          stage.style.perspective = `${R * 3}px`;
          stage.style.setProperty("--R", `${R}px`);
          stage.style.setProperty("--tw", `${R * 0.15}px`);
          stage.style.setProperty("--tht", `${R * 0.16}px`);
        };
        layout();
        new ResizeObserver(layout).observe(stage);

        const BASE_PITCH = -6;
        const AUTO_SPEED = reduce ? 0 : 0.07;
        let yaw = 0, pitch = BASE_PITCH, vYaw = 0, vPitch = 0;
        let dragging = false, inside = false;
        let lastX = 0, lastY = 0, hoverX = 0, hoverY = 0;
        let running = true, last = performance.now();
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

        const render = () => {
          sphere.style.transform = `translateZ(${-R}px) rotateX(${pitch}deg) rotateY(${yaw}deg)`;
        };

        const frame = (now) => {
          const dt = Math.min((now - last) / 16.667, 3);
          last = now;
          if (running && !dragging) {
            const hoverSpin = inside && !reduce ? hoverX * 0.16 : 0;
            yaw = (yaw + (vYaw + AUTO_SPEED + hoverSpin) * dt) % 360;
            pitch += vPitch * dt;
            const target = BASE_PITCH + (inside && !reduce ? hoverY * 8 : 0);
            pitch += (target - pitch) * 0.035 * dt;
            pitch = clamp(pitch, -40, 40);
            const decay = Math.pow(0.95, dt);
            vYaw *= decay;
            vPitch *= decay;
          }
          if (running) render();
          requestAnimationFrame(frame);
        };

        stage.addEventListener("pointerdown", (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          vYaw = 0;
          vPitch = 0;
          stage.classList.add("is-dragging");
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener("pointermove", (e) => {
          const r = stage.getBoundingClientRect();
          hoverX = ((e.clientX - r.left) / r.width - 0.5) * 2;
          hoverY = ((e.clientY - r.top) / r.height - 0.5) * 2;
          inside = true;
          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          yaw += dx * 0.3;
          pitch = clamp(pitch - dy * 0.2, -40, 40);
          vYaw = clamp(dx * 0.3, -8, 8);
          vPitch = clamp(-dy * 0.2, -5, 5);
        });

        const endDrag = () => {
          dragging = false;
          stage.classList.remove("is-dragging");
        };
        stage.addEventListener("pointerup", endDrag);
        stage.addEventListener("pointercancel", endDrag);
        stage.addEventListener("pointerleave", () => { inside = false; });

        new IntersectionObserver(([entry]) => {
          running = entry.isIntersecting;
          last = performance.now();
        }).observe(stage);

        render();
        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>