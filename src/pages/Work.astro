---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/work.css";
import "../styles/footer.css";
import { getEntry, getCollection } from "astro:content";

const workPageEntry = await getEntry("workPage", "index");

if (!workPageEntry) {
  throw new Error("Could not find index.md in src/content/workPage/");
}

const pageData = workPageEntry.data;

const rawProjects = await getCollection("projects");

const projects = rawProjects.map((item, index) => ({
  id: item.id,
  ...item.data,
  video: `/videos/video${(index % 3) + 1}.mp4`,
}));

const heroPoster =
  "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=85";

/* Hero title: pehla aadha white, doosra aadha muted (Industries jaisa) */
const heroWords = pageData.heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);

const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Case Studies: BIM, Revit & Visualization | Axys3D" description={pageData.heroDescription} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-work">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="wrk-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="work-page">
      <!-- ================= HERO ================= -->
      <section class="wrk-intro">
        <div class="wrk-wrap">
          <div class="wrk-intro-row">
            <div class="wrk-intro-header">
              <span class="wrk-kicker">{pageData.heroTitle}</span>
              <h1 class="wrk-h1">
                <span class="wrk-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["wrk-word", { "wrk-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{pageData.heroSubtitle}</span>
              </h1>
              <p class="wrk-lead">{pageData.heroDescription}</p>
            </div>

            <div class="wrk-intro-media">
              <svg class="isl-flow" viewBox="0 0 820 520" role="img" aria-label="How we work: brief, expert analysis, sketch and 2D plan, 3D BIM model, renders and film" preserveAspectRatio="xMidYMid meet">
                <defs>
                  <!-- Gradients -->
                  <linearGradient id="isl-trace-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#aea7a3" stop-opacity="0.3"/>
                    <stop offset="50%" stop-color="#d2b487" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="1"/>
                  </linearGradient>

                  <linearGradient id="glass-spec" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0.03"/>
                  </linearGradient>

                  <linearGradient id="slab-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#2a2927"/>
                    <stop offset="100%" stop-color="#121110"/>
                  </linearGradient>

                  <radialGradient id="isl-coreGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#d2b487" stop-opacity="0.22"/>
                    <stop offset="100%" stop-color="#d2b487" stop-opacity="0"/>
                  </radialGradient>

                  <filter id="isl-laserGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="3.5" result="coloredBlur"/>
                    <feMerge>
                      <feMergeNode in="coloredBlur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>
                </defs>

                <!-- Technical CAD Grid & Alignment Guides -->
                <g class="isl-cad-grid" opacity="0.18" stroke="#8f8b88" stroke-width="0.7">
                  <path d="M 40 120 H 780 M 40 220 H 780 M 40 320 H 780 M 40 420 H 780" stroke-dasharray="3 9"/>
                  <path d="M 100 40 V 480 M 280 40 V 480 M 430 40 V 480 M 590 40 V 480 M 720 40 V 480" stroke-dasharray="3 9"/>
                  <path d="M 275 220 h 10 M 280 215 v 10 M 425 320 h 10 M 430 315 v 10 M 585 120 h 10 M 590 115 v 10" stroke="#d2b487" stroke-width="1.2" stroke-dasharray="none"/>
                </g>

                <!-- Ambient Glows -->
                <circle cx="280" cy="420" r="140" fill="url(#isl-coreGlow)"/>
                <circle cx="590" cy="230" r="150" fill="url(#isl-coreGlow)"/>

                <!-- Pipeline Datum Rails -->
                <path class="isl-datum-rail" d="M40 395 C130 455, 250 470, 335 405 C420 340, 440 275, 520 262 C610 250, 670 190, 765 110" fill="none"/>
                <path class="isl-datum-ticks" d="M40 395 C130 455, 250 470, 335 405 C420 340, 440 275, 520 262 C610 250, 670 190, 765 110" fill="none"/>

                <!-- Precision Laser Pulse -->
                <path class="isl-laser-tail" d="M40 395 C130 455, 250 470, 335 405 C420 340, 440 275, 520 262 C610 250, 670 190, 765 110" pathLength="100" fill="none"/>
                <path class="isl-laser-beam" d="M40 395 C130 455, 250 470, 335 405 C420 340, 440 275, 520 262 C610 250, 670 190, 765 110" pathLength="100" fill="none" filter="url(#isl-laserGlow)"/>
                <path class="isl-laser-head" d="M40 395 C130 455, 250 470, 335 405 C420 340, 440 275, 520 262 C610 250, 670 190, 765 110" pathLength="100" fill="none"/>

                <!-- STEP 01: BRIEF -->
                <g transform="translate(97.1, 425.3)">
                  <circle class="isl-anchor-ring isl-ring1" r="26" fill="none"/>
                  <circle class="isl-anchor-dot isl-node1" r="3.5"/>
                  <g class="isl-stage-tag" transform="translate(0, 24)">
                    <text class="isl-tag-num" x="0" y="0">STEP 01</text>
                    <text class="isl-tag-title" x="0" y="20">BRIEF</text>
                  </g>
                  <g class="isl-module isl-stage1" transform="translate(0, -42)">
                    <g class="isl-hover-float">
                      <rect x="-32" y="-38" width="64" height="52" rx="3" fill="url(#glass-spec)" stroke="rgba(210,180,135,0.45)" stroke-width="1.2"/>
                      <rect x="-32" y="-38" width="64" height="11" rx="3" fill="rgba(210,180,135,0.16)"/>
                      <text x="-26" y="-30" fill="#d2b487" font-size="5.5" font-family="monospace" letter-spacing="0.8">CLIENT BRIEF</text>
                      <line x1="-26" y1="-19" x2="-10" y2="-19" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-2" y1="-19" x2="24" y2="-19" stroke="#d6d3d0" stroke-width="1.2" opacity="0.8"/>
                      <line x1="-26" y1="-9" x2="-10" y2="-9" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-2" y1="-9" x2="18" y2="-9" stroke="#d6d3d0" stroke-width="1.2" opacity="0.8"/>
                      <line x1="-26" y1="1" x2="-10" y2="1" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-2" y1="1" x2="22" y2="1" stroke="#d6d3d0" stroke-width="1.2" opacity="0.8"/>
                      <circle cx="22" cy="8" r="2.4" fill="#d2b487"/>
                    </g>
                  </g>
                </g>

                <!-- STEP 02: EXPERT ANALYSIS -->
                <g transform="translate(281.8, 434.2)">
                  <circle class="isl-anchor-ring isl-ring2" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node2" r="3.5"/>
                  <g class="isl-stage-tag" transform="translate(0, 24)">
                    <text class="isl-tag-num" x="0" y="0">STEP 02</text>
                    <text class="isl-tag-title" x="0" y="20">EXPERT ANALYSIS</text>
                  </g>
                  <g class="isl-module isl-stage2" transform="translate(0, -48)">
                    <g class="isl-hover-float" style="animation-delay: -1.2s">
                      <rect x="-30" y="-40" width="46" height="56" rx="3" fill="url(#glass-spec)" stroke="rgba(210,180,135,0.45)" stroke-width="1.2"/>
                      <line x1="-23" y1="-30" x2="9" y2="-30" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-23" y1="-22" x2="2" y2="-22" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-23" y1="-14" x2="9" y2="-14" stroke="#8f8b88" stroke-width="1.2"/>
                      <line x1="-23" y1="-6" x2="-4" y2="-6" stroke="#8f8b88" stroke-width="1.2"/>
                      <circle cx="12" cy="-8" r="15" fill="rgba(10,10,10,0.7)" stroke="#d2b487" stroke-width="1.6"/>
                      <line x1="23" y1="3" x2="34" y2="14" stroke="#d2b487" stroke-width="3" stroke-linecap="round"/>
                      <path class="isl-check-mark" d="M5 -8 L10 -3 L19 -14" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                  </g>
                </g>

                <!-- STEP 03: SKETCH & 2D PLAN -->
                <g transform="translate(425.5, 317.9)">
                  <circle class="isl-anchor-ring isl-ring3" r="30" fill="none"/>
                  <circle class="isl-anchor-dot isl-node3" r="3.5"/>
                  <g class="isl-stage-tag" transform="translate(0, 24)">
                    <text class="isl-tag-num" x="0" y="0">STEP 03</text>
                    <text class="isl-tag-title" x="0" y="20">SKETCH &amp; 2D PLAN</text>
                  </g>
                  <g class="isl-module isl-stage3" transform="translate(0, -50)">
                    <g class="isl-hover-float" style="animation-delay: -2.4s">
                      <rect x="-36" y="-38" width="72" height="54" rx="3" fill="url(#glass-spec)" stroke="rgba(210,180,135,0.45)" stroke-width="1.2"/>
                      <path d="M-28 -30 H8 V-8 H28 M-28 -8 H-6 M-6 -8 V8 M8 -8 V8" fill="none" stroke="#d6d3d0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M-28 8 H-14" fill="none" stroke="#d2b487" stroke-width="1.4"/>
                      <path d="M20 -8 a8 8 0 0 0 -8 8" fill="none" stroke="#8f8b88" stroke-width="1"/>
                      <line x1="-28" y1="22" x2="28" y2="22" stroke="#d2b487" stroke-width="1"/>
                      <line x1="-28" y1="19" x2="-28" y2="25" stroke="#d2b487" stroke-width="1"/>
                      <line x1="28" y1="19" x2="28" y2="25" stroke="#d2b487" stroke-width="1"/>
                      <circle cx="8" cy="-8" r="4.5" fill="#d2b487" fill-opacity="0.25" stroke="#d2b487" stroke-width="1.2" class="isl-pulse-sensor"/>
                    </g>
                  </g>
                </g>

                <!-- STEP 04: 3D BIM MODEL -->
                <g transform="translate(586.4, 242.9)">
                  <circle class="isl-anchor-ring isl-ring4" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node4" r="3.5"/>
                  <g class="isl-stage-tag" transform="translate(0, 24)">
                    <text class="isl-tag-num" x="0" y="0">STEP 04</text>
                    <text class="isl-tag-title" x="0" y="20">3D BIM MODEL</text>
                  </g>
                  <g class="isl-module isl-stage4" transform="translate(0, -46)">
                    <g class="isl-hover-float" style="animation-delay: -0.8s">
                      <polygon points="0,-18 30,-4 0,10 -30,-4" fill="url(#slab-grad)" stroke="#d2b487" stroke-width="1.2" opacity="0.9"/>
                      <polygon points="0,-34 30,-20 0,-6 -30,-20" fill="url(#slab-grad)" stroke="rgba(210,180,135,0.7)" stroke-width="1"/>
                      <polygon points="0,-50 30,-36 0,-22 -30,-36" fill="url(#glass-spec)" stroke="#d2b487" stroke-width="1.2"/>
                      <line x1="-30" y1="-4" x2="-30" y2="-36" stroke="#7a7673" stroke-width="1.2"/>
                      <line x1="0" y1="10" x2="0" y2="-22" stroke="#d2b487" stroke-width="1.4"/>
                      <line x1="30" y1="-4" x2="30" y2="-36" stroke="#7a7673" stroke-width="1.2"/>
                      <line x1="-15" y1="3" x2="-15" y2="-29" stroke="rgba(174,167,163,0.6)" stroke-width="0.9" stroke-dasharray="2 2"/>
                      <line x1="15" y1="3" x2="15" y2="-29" stroke="rgba(174,167,163,0.6)" stroke-width="0.9" stroke-dasharray="2 2"/>
                      <line class="isl-scan-line" x1="-32" y1="-20" x2="32" y2="-20" stroke="#ffffff" stroke-width="1.2" opacity="0.7"/>
                    </g>
                  </g>
                </g>

                <!-- STEP 05: RENDERS & FILM -->
                <g transform="translate(720.5, 147.8)">
                  <circle class="isl-anchor-ring isl-ring5" r="30" fill="none"/>
                  <circle class="isl-anchor-dot isl-node5" r="3.5"/>
                  <g class="isl-stage-tag" transform="translate(0, 24)">
                    <text class="isl-tag-num" x="0" y="0">STEP 05</text>
                    <text class="isl-tag-title" x="0" y="20">RENDERS &amp; FILM</text>
                  </g>
                  <g class="isl-module isl-stage5" transform="translate(0, -48)">
                    <g class="isl-hover-float" style="animation-delay: -1.8s">
                      <rect x="-38" y="-38" width="76" height="52" rx="4" fill="#0f0e0e" stroke="rgba(210,180,135,0.5)" stroke-width="1.2"/>
                      <rect x="-33" y="-33" width="66" height="42" rx="2" fill="url(#glass-spec)"/>
                      <path d="M-33 9 L-14 -10 L-2 2 L10 -14 L33 9 Z" fill="rgba(174,167,163,0.28)" stroke="#aea7a3" stroke-width="0.9" stroke-linejoin="round"/>
                      <circle cx="-20" cy="-20" r="4" fill="#d2b487" opacity="0.9"/>
                      <circle cx="0" cy="-12" r="11" fill="rgba(10,10,10,0.55)" stroke="#ffffff" stroke-width="1.4"/>
                      <polygon points="-3,-18 -3,-6 7,-12" fill="#ffffff"/>
                      <g fill="#8f8b88"><rect x="-34" y="18" width="7" height="5" rx="1"/><rect x="-23" y="18" width="7" height="5" rx="1"/><rect x="-12" y="18" width="7" height="5" rx="1"/><rect x="-1" y="18" width="7" height="5" rx="1"/><rect x="10" y="18" width="7" height="5" rx="1"/><rect x="21" y="18" width="7" height="5" rx="1"/></g>
                      <ellipse cx="0" cy="-12" rx="46" ry="15" fill="none" stroke="rgba(210,180,135,0.6)" stroke-width="1.1" stroke-dasharray="4 4" class="isl-orbit-ring"/>
                    </g>
                  </g>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= CASE STUDIES (2 x 2 CARDS) ================= -->
      <section class="wrk-cards-sec" id="case-studies">
        <div class="wrk-wrap">
          <div class="wrk-sec-head wrk-sec-head--row" data-reveal>
            <div>
              <span class="wrk-kicker">CASE STUDIES</span>
              <h2 class="wrk-sec-h2">A closer look at <br /><span>our selected work.</span></h2>
            </div>
          </div>

          <div class="wrk-cards-grid">
            {projects.map((project, index) => (
              <a
                class="wrk-card"
                href={`/work/${project.id}`}
                data-reveal
                style={`--d: ${(index % 2) * 120}ms`}
                aria-label={`View ${project.title} case study`}
              >
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                ></video>
                <div class="wrk-card-overlay"></div>
                <div class="wrk-card-shine"></div>

                <div class="wrk-card-body">
                  <span class="wrk-card-num">{pad(index + 1)}</span>
                  <span class="wrk-card-target">{project.badgeText}</span>
                  <h3 class="wrk-card-title">{project.title}</h3>
                  <p class="wrk-card-desc">{project.summary}</p>
                  <span class="wrk-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

          {projects.length === 0 && (
            <div class="wrk-no-results">
              <p>No case studies available yet.</p>
            </div>
          )}
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="wrk-final-cta">
        <div class="wrk-wrap">
          <div class="wrk-final-inner" data-reveal>
            <h2>Let's turn your project <br /><span>into something visual.</span></h2>
            <p>Tell us what you're building and we'll help you define the right visual production approach.</p>
            <a href="/contact" class="wrk-final-button">
              <span>Discuss a project</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Reveal on scroll
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      // Card spotlight: light follows the cursor
      document.querySelectorAll(".wrk-card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>