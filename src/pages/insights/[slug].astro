---
// src/pages/insights/[slug].astro
import SEO from "../../components/SEO.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/token.css";
import "../../styles/global.css";
import "../../styles/Navbar.css";
import "../../styles/insights.css";
import "../../styles/footer.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("insights");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const pd = article.data.publishedDate ? new Date(article.data.publishedDate) : null;
const publishedISO = pd && !isNaN(pd.getTime()) ? pd.toISOString() : undefined;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: publishedISO,
  author: { "@type": "Organization", name: "Axys3D" },
  publisher: { "@type": "Organization", name: "Axys3D" },
};

/* ---------- Saare articles (sidebar + related ke liye) ---------- */
const allArticles = await getCollection("insights");
const others = allArticles.filter((a) => a.id !== article.id);
const recent = others.slice(0, 3);
const sameCategory = others.filter((a) => a.data.category === article.data.category);
const related = (sameCategory.length >= 2 ? sameCategory : others).slice(0, 2);

/* Categories + counts (right sidebar) */
const categoryCounts = Object.entries(
  allArticles.reduce((acc: Record<string, number>, a) => {
    acc[a.data.category] = (acc[a.data.category] || 0) + 1;
    return acc;
  }, {})
);

/* ---------- Images (listing page wali hi list, taake same image aaye) ---------- */
const q = "?auto=format&fit=crop&w=1400&q=80";
const articleImages = [
  `https://images.unsplash.com/photo-1486406146926-c627a92ad1ab${q}`,
  `https://images.unsplash.com/photo-1600585154340-be6161a56a0c${q}`,
  `https://images.unsplash.com/photo-1487958449943-2429e8be8625${q}`,
  `https://images.unsplash.com/photo-1600596542815-ffad4c1539a9${q}`,
  `https://images.unsplash.com/photo-1518005020951-eccb494ad742${q}`,
  `https://images.unsplash.com/photo-1613977257363-707ba9348227${q}`,
  `https://images.unsplash.com/photo-1497366216548-37526070297c${q}`,
  `https://images.unsplash.com/photo-1600585154526-990dced4db0d${q}`,
];
const imageFor = (a: any) => {
  const idx = Math.max(0, allArticles.findIndex((x) => x.id === a.id));
  return (a.data as any).image ?? articleImages[idx % articleImages.length];
};
const heroImage = imageFor(article);
const aboutImage = `https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=700&q=80`;

/* ---------- Meta ---------- */
const rt = String(article.data.readTime ?? "").trim();
const author = (article.data as any).author ?? "AXYS3D Editorial";
const rawDate = (article.data as any).date ?? (article.data as any).pubDate ?? (article.data as any).publishedAt;
const dateText = rawDate
  ? new Date(rawDate).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
  : "";
const metaParts = [article.data.category, rt, dateText].filter(Boolean);

/* ---------- Share links ---------- */
const pageUrl = encodeURIComponent(Astro.url.href);
const pageTitle = encodeURIComponent(article.data.title);
const shareLinks = [
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}` },
  { label: "X", href: `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}` },
  { label: "WhatsApp", href: `https://wa.me/?text=${pageTitle}%20${pageUrl}` },
];
const initials = author.split(/\s+/).map((w: string) => w[0]).join("").slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={`${article.data.title} | Axys3D Insights`} description={article.data.summary} type="article" jsonLd={articleLd} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-insight-single">
    <div class="isd-page-bg" aria-hidden="true"></div>

    <Navbar variant="transparent" />

    <main class="isd-page">
      <!-- ================= TITLE + META (center) ================= -->
      <header class="isd-head">
        <div class="isd-wrap">
          <h1 class="isd-title">{article.data.title}</h1>
          <p class="isd-meta">
            {metaParts.map((m, i) => (
              <Fragment>
                {i > 0 && <span class="isd-meta-dot" aria-hidden="true">·</span>}
                <span>{m}</span>
              </Fragment>
            ))}
            <span class="isd-meta-dot" aria-hidden="true">·</span>
            <span>By {author}</span>
          </p>
        </div>
      </header>

      <!-- ================= 3 COLUMN LAYOUT ================= -->
      <div class="isd-wrap isd-layout">
        <!-- LEFT SIDEBAR -->
        <aside class="isd-side isd-side--left">
          <section class="isd-widget">
            <h4 class="isd-widget-title">About AXYS3D</h4>
            <img class="isd-about-img" src={aboutImage} alt="" loading="lazy" decoding="async" />
            <p class="isd-widget-text">
              We turn drawings, sketches and BIM models into checked 3D models, photoreal renders and walkthroughs.
            </p>
          </section>

          <section class="isd-widget">
            <h4 class="isd-widget-title">Let's connect</h4>
            <ul class="isd-links">
              <li><a href="/contact">Contact us <span>↗</span></a></li>
              <li><a href="/work">Our work <span>↗</span></a></li>
              <li><a href="/insights">All insights <span>↗</span></a></li>
            </ul>
          </section>
        </aside>

        <!-- MAIN ARTICLE -->
        <article class="isd-main">
          <figure class="isd-hero-img">
            <img src={heroImage} alt={article.data.title} loading="eager" decoding="async" />
          </figure>

          <p class="isd-summary">{article.data.summary}</p>

          <div class="isd-prose">
            <Content />
          </div>

          <!-- Share -->
          <div class="isd-share">
            <span class="isd-share-label">Share this</span>
            <div class="isd-share-list">
              {shareLinks.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              ))}
              <button type="button" id="isdCopy" data-label="Copy link">Copy link</button>
            </div>
          </div>

          <!-- Author -->
          <div class="isd-author">
            <div class="isd-author-avatar" aria-hidden="true">{initials}</div>
            <div>
              <h4>{author}</h4>
              <p>Technical notes from the AXYS3D team on controlled BIM, MEP and visualization delivery for architects and developers.</p>
            </div>
          </div>

          <!-- Related -->
          {related.length > 0 && (
            <section class="isd-related">
              <h4 class="isd-widget-title">Related posts</h4>
              <div class="isd-related-grid">
                {related.map((r) => (
                  <a class="isd-rel" href={`/insights/${r.id}`}>
                    <span class="isd-rel-img">
                      <img src={imageFor(r)} alt="" loading="lazy" decoding="async" />
                    </span>
                    <span class="isd-rel-cat">{r.data.category}</span>
                    <span class="isd-rel-title">{r.data.title}</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>

        <!-- RIGHT SIDEBAR -->
        <aside class="isd-side isd-side--right">
          {recent.length > 0 && (
            <section class="isd-widget">
              <h4 class="isd-widget-title">Recent posts</h4>
              <ul class="isd-recent">
                {recent.map((r) => (
                  <li>
                    <a href={`/insights/${r.id}`}>
                      <span class="isd-recent-cat">{r.data.category}</span>
                      <span class="isd-recent-title">{r.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="isd-widget">
            <h4 class="isd-widget-title">Categories</h4>
            <ul class="isd-cats">
              {categoryCounts.map(([name, n]) => (
                <li><span>{name}</span><em>{n}</em></li>
              ))}
            </ul>
          </section>
        </aside>
      </div>

      <!-- ================= FINAL CTA ================= -->
      <section class="isd-final-cta">
        <div class="isd-wrap">
          <div class="isd-final-inner isd-reveal">
            <h2>Want these workflows <br /><span>in your firm?</span></h2>
            <p>Schedule a workflow review session with our technical leads.</p>
            <a href="/contact" class="isd-final-btn">
              <span>Book technical session</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Copy link
      (function () {
        const btn = document.getElementById("isdCopy");
        if (!btn) return;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(location.href);
            btn.textContent = "Copied ✓";
          } catch (e) {
            btn.textContent = "Copy failed";
          }
          setTimeout(() => (btn.textContent = btn.dataset.label), 1800);
        });
      })();

      // Reveal on scroll (sirf CTA)
      const revealItems = document.querySelectorAll(".isd-reveal");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));
    </script>
  </body>
</html>